    private async Task<bool> HandleInterceptAction(string actionId)
    {
        if (string.Equals(actionId, "verso.action.run-all", StringComparison.OrdinalIgnoreCase))
        {
            await HandleRunAll();
            return true;
        }

        if (string.Equals(actionId, "verso.action.run-cell", StringComparison.OrdinalIgnoreCase)
            && _selectedCellId.HasValue)
        {
            await HandleRunCell(_selectedCellId.Value);
            return true;
        }

        return false;
    }

    private async Task HandleActionExecuted(string actionId)
    {
        if (string.Equals(actionId, "verso.action.run-all", StringComparison.OrdinalIgnoreCase))
            _selectedCellId = null;

        if (string.Equals(actionId, "verso.action.restart-kernel", StringComparison.OrdinalIgnoreCase))
            await ShowStatusAsync(UI.Status_KernelRestarted);

        StateHasChanged();
    }

    private Task HandleError(string message)
    {
        _error = message;
        return Task.CompletedTask;
    }

    // ── Comparing with a baseline ──────────────────────────────────────

    private async Task LoadDiffSourcesAsync()
    {
        try
        {
            await _comparison.LoadSourcesAsync();
        }
        catch (Exception ex)
        {
            _diffErrorMessage = string.Format(UI.Error_ListComparisonSources, ex.Message);
        }

        StateHasChanged();
    }

    /// <summary>
    /// Runs a comparison against the chosen baseline. Sources that need extra input (a git ref
    /// or a file path) defer to this page's picker on hosts whose notebook UI owns that prompt;
    /// embedded hosts prompt natively inside <c>ComputeDiffAsync</c>.
    /// </summary>
    private async Task HandleCompareRequested(DiffSourceInfo source)
    {
        if (!Service.IsEmbedded && source.Id is "gitRef" or "file")
        {
            _diffSourcePickerKind = source.Id;
            _showDiffSourcePicker = true;
            return;
        }

        await CompareAsync(source.Id, null);
    }

    private async Task CompareAsync(string sourceId, string? explicitInput)
    {
        try
        {
            await _comparison.CompareAsync(sourceId, explicitInput);
        }
        catch (Exception ex)
        {
            _diffErrorMessage = ex.Message;
        }

        StateHasChanged();
    }

    private async Task StopComparingAsync()
    {
        _comparison.Clear();
        _showDiffView = false;
        await Task.CompletedTask;
    }

    private void CloseDiffView() => _showDiffView = false;

    /// <summary>
    /// Brings the cell behind a change into view. Selection is what the scroll helper keys
    /// off, and in a display layout the cascaded context drops the selection anyway, so the
    /// cell is revealed there without being selected. The scroll itself happens in
    /// <c>OnAfterRenderAsync</c>, once the selection has actually moved in the DOM.
    /// </summary>
    private Task RevealCellAsync(Guid cellId)
    {
        _selectedCellId = cellId;
        _pendingReveal = _hasRendered;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task HandleDiffSourceInputSubmitted(string input)
    {
        _showDiffSourcePicker = false;
        await CompareAsync(_diffSourcePickerKind, input);
    }

    // A kernel restart replaces the backing session, so a diff computed against it is stale;
    // drop it rather than keep marking cells against a baseline that no longer applies.
    private void HandleKernelRestartingForDiff(string? reason)
    {
        if (!_comparison.IsActive)
            return;

        _ = InvokeAsync(() =>
        {
            _comparison.Clear();
            _showDiffView = false;
            StateHasChanged();
        });
    }

    // The host asked for a comparison (in VS Code, the "Compare Notebook with..." command).
    // Open the panel either way, so a comparison that arrives from outside lands somewhere
    // the reader can see and act on rather than straight into a full-screen diff.
    private void HandleDiffRequested(string? sourceId)
    {
        _ = InvokeAsync(async () =>
        {
            _activePanel = HostPanels.Compare;

            if (sourceId is not null)
            {
                await CompareAsync(sourceId, null);
            }
            else
            {
                await LoadDiffSourcesAsync();
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _autoSaveTimer?.Dispose();
        _statusCts?.Cancel();
        _statusCts?.Dispose();
        _panelResizeRef?.Dispose();
        _cellInteractRef?.Dispose();
        _cellDragRef?.Dispose();
        _layoutInteractRef?.Dispose();
        _outputChannelRef?.Dispose();
        Service.OnCellExecuted -= HandleCellExecutedRefresh;
        Service.OnCellExecuting -= HandleCellExecutingEvent;
        Service.OnCellExecutionCompleted -= HandleCellExecutedEvent;
        Service.OnNotebookChanged -= StateHasChanged;
        Service.OnLayoutChanged -= HandleLayoutChanged;
        Service.OnThemeChanged -= HandleThemeChanged;
        Service.OnExtensionStatusChanged -= HandleExtensionStatusChanged;
        Service.OnVariablesChanged -= HandleVariablesChanged;
        Service.OnSettingsChanged -= HandleSettingsChanged;
        Service.OnOutputUpdated -= HandleOutputUpdated;
        Service.OnRequiredExtensionsUnavailable -= HandleExtensionsUnavailable;
        Service.OnKernelRestarting -= HandleKernelRestartingForDiff;
        Service.OnDiffRequested -= HandleDiffRequested;

        if (Service is ServerNotebookService serverService)
        {
            serverService.OnExtensionConsentRequested -= HandleExtensionConsentRequested;
            serverService.OnInputRequested -= HandleInputRequested;
        }
    }

    /// <summary>
    /// Fills a sentence's placeholders with literal text drawn in a code style. The sentence is
    /// one resource rather than the fragments between the placeholders, because word order moves
    /// with the language while a file extension does not.
    /// </summary>
    private static MarkupString Sentence(string sentence, params string[] values)
        => new(string.Format(
            sentence,
            values.Select(v => $"<code>{System.Net.WebUtility.HtmlEncode(v)}</code>").ToArray()));

    /// <summary>
    /// Whether an exception is a cancellation the reader asked for, rather than a fault.
    /// </summary>
    /// <remarks>
    /// Cancellation reaches here wrapped in other exception types as well as on its own, so
    /// the inner exception is checked too. The message is the last resort and not the first,
    /// because the runtime writes it in the interface language: matching English text would
    /// stop recognising a cancellation the moment somebody reads Verso in German.
    /// </remarks>
    private static bool IsCancellation(Exception ex)
        => ex is OperationCanceledException
            || ex.InnerException is OperationCanceledException
            || ex.Message.Contains("operation was canceled", StringComparison.OrdinalIgnoreCase);

    private void HandleExtensionsUnavailable(IReadOnlyList<UnavailableExtensionInfo> unavailable)
    {
        _ = InvokeAsync(async () => await ShowStatusAsync(FormatUnavailableExtensions(unavailable)));
    }

    private static string FormatUnavailableExtensions(IReadOnlyList<UnavailableExtensionInfo> unavailable)
    {
        var names = string.Join(", ", unavailable.Select(u => u.PackageId));
        // Two whole sentences rather than a shared tail, so the pronoun at the end can
        // agree with the number at the start.
        return unavailable.Count == 1
            ? string.Format(UI.Status_RequiredExtensionUnavailable_One, names)
            : string.Format(UI.Status_RequiredExtensionUnavailable_Other, unavailable.Count, names);
    }
}
