    // The cell to select when a notebook opens: the first cell that will not display as
    // rendered markup. Selecting a rendered cell (e.g. a Markdown title) would swap it back
    // to its editor, defeating render-on-open for the most common first cell in prose-heavy
    // notebooks. Mirrors the preview-mode condition in Cell.razor.
    private Guid? InitialCellSelection() => Service.Cells.FirstOrDefault(c =>
            !(Service.ShouldCollapseInput(c.Type)
              && c.Outputs.Count > 0
              && !string.IsNullOrWhiteSpace(c.Source)))
        ?.Id;

