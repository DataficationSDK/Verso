    {
        await Service.UpdateCellSourceAsync(args.CellId, args.Source);
    }

    private async Task HandleCellTypeChanged((Guid CellId, string NewType) args)
    {
        await Service.ChangeCellTypeAsync(args.CellId, args.NewType);
    }

    private async Task HandleCellLanguageChanged((Guid CellId, string NewLanguage) args)
    {
        await Service.ChangeCellLanguageAsync(args.CellId, args.NewLanguage);
    }

    private async Task<bool> HandleInterceptAction(string actionId)
    {
        if (string.Equals(actionId, "verso.action.run-all", StringComparison.OrdinalIgnoreCase))
        {
            await HandleRunAll();
            return true;
        }

        if (string.Equals(actionId, "verso.action.run-cell", StringComparison.OrdinalIgnoreCase)
            && _selectedCellId.HasValue)
        {
            await HandleRunCell(_selectedCellId.Value);
            return true;
        }

        return false;
    }

    private async Task HandleActionExecuted(string actionId)
    {
        if (string.Equals(actionId, "verso.action.run-all", StringComparison.OrdinalIgnoreCase))
            _selectedCellId = null;

        if (string.Equals(actionId, "verso.action.restart-kernel", StringComparison.OrdinalIgnoreCase))
            await ShowStatusAsync("Kernel restarted");

        StateHasChanged();
    }

    private Task HandleError(string message)
    {
        _error = message;
        return Task.CompletedTask;
    }

    // ── Notebook diff ──────────────────────────────────────────────────

    private void HandleDiffComputed(NotebookDiffResult result)
    {
        _diffResult = result;
        _showDiffView = true;
        _showDiffSourcePicker = false;
    }

    private void CloseDiffView()
    {
        _showDiffView = false;
        _diffResult = null;
    }

    private void HandleDiffPickerRequested(string sourceId)
    {
        _diffSourcePickerKind = sourceId;
        _showDiffSourcePicker = true;
    }

    private void HandleDiffError(string message)
    {
        _diffErrorMessage = message;
    }

    private async Task HandleDiffSourceInputSubmitted(string input)
    {
        _showDiffSourcePicker = false;
        if (_toolbar is not null)
        {
            await _toolbar.ComputeDiffAsync(_diffSourcePickerKind, input);
        }
    }

    // A kernel restart replaces the backing session, so a diff computed against it is stale;
    // close rather than display results that no longer describe the live notebook.
    private void HandleKernelRestartingForDiff(string? reason)
    {
        if (!_showDiffView)
            return;

        _ = InvokeAsync(() =>
        {
            CloseDiffView();
            StateHasChanged();
        });
    }

    private void HandleDiffRequested(string? sourceId)
    {
        _ = InvokeAsync(async () =>
        {
            if (_toolbar is null)
                return;

            if (sourceId is not null)
            {
                await _toolbar.ComputeDiffAsync(sourceId, null);
            }
            else
            {
                await _toolbar.OpenCompareMenuAsync();
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _autoSaveTimer?.Dispose();
        _statusCts?.Cancel();
        _statusCts?.Dispose();
        _panelResizeRef?.Dispose();
        _cellInteractRef?.Dispose();
        _cellDragRef?.Dispose();
        _layoutInteractRef?.Dispose();
        Service.OnCellExecuted -= HandleCellExecutedRefresh;
        Service.OnCellExecuting -= HandleCellExecutingEvent;
        Service.OnCellExecutionCompleted -= HandleCellExecutedEvent;
        Service.OnNotebookChanged -= StateHasChanged;
        Service.OnLayoutChanged -= HandleLayoutChanged;
        Service.OnThemeChanged -= HandleThemeChanged;
        Service.OnExtensionStatusChanged -= HandleExtensionStatusChanged;
        Service.OnVariablesChanged -= HandleVariablesChanged;
        Service.OnSettingsChanged -= HandleSettingsChanged;
        Service.OnOutputUpdated -= HandleOutputUpdated;
        Service.OnRequiredExtensionsUnavailable -= HandleExtensionsUnavailable;
        Service.OnKernelRestarting -= HandleKernelRestartingForDiff;
        Service.OnDiffRequested -= HandleDiffRequested;

        if (Service is ServerNotebookService serverService)
        {
            serverService.OnExtensionConsentRequested -= HandleExtensionConsentRequested;
            serverService.OnInputRequested -= HandleInputRequested;
        }
    }

    private void HandleExtensionsUnavailable(IReadOnlyList<UnavailableExtensionInfo> unavailable)
    {
        _ = InvokeAsync(async () => await ShowStatusAsync(FormatUnavailableExtensions(unavailable)));
    }

    private static string FormatUnavailableExtensions(IReadOnlyList<UnavailableExtensionInfo> unavailable)
    {
        var names = string.Join(", ", unavailable.Select(u => u.PackageId));
        var lead = unavailable.Count == 1
            ? $"Required extension {names} could not be loaded"
            : $"{unavailable.Count} required extensions could not be loaded: {names}";
        return $"{lead}. Some layouts or cells may not work until it is available.";
    }
}
