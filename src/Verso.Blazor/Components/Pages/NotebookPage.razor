@page "/"
@implements IDisposable
@using Verso.Abstractions
@using Verso.Blazor.Services
@inject INotebookService Service
@inject IJSRuntime JS

<PageTitle>Verso Notebook</PageTitle>

<ThemeProvider Theme="@Service.ActiveThemeData" />

<div class="verso-notebook"
     tabindex="0" @onkeydown="HandleKeyDown">
    <Toolbar Service="Service"
             SelectedCellId="_selectedCellId"
             IsExecuting="_executionInProgress"
             OnNewNotebook="HandleNew"
             OnOpenNotebook="HandleOpen"
             OnBrowseNotebook="HandleBrowse"
             OnSaveNotebook="HandleSave"
             OnAddCell="HandleAddCell"
             OnActionExecuted="HandleActionExecuted"
             OnInterceptAction="HandleInterceptAction"
             OnError="HandleError"
             OnDiffComputed="HandleDiffComputed"
             OnDiffPickerRequested="HandleDiffPickerRequested"
             OnDiffError="HandleDiffError"
             @ref="_toolbar" />

    @if (_showDiffView && _diffResult is not null)
    {
        <NotebookDiffView Diff="_diffResult" OnClose="CloseDiffView" />
    }

    <DiffSourcePickerDialog IsVisible="_showDiffSourcePicker"
                            Kind="@_diffSourcePickerKind"
                            OnSubmit="HandleDiffSourceInputSubmitted"
                            OnCancel="() => _showDiffSourcePicker = false" />

    <DiffErrorDialog Message="@_diffErrorMessage" OnDismiss="() => _diffErrorMessage = null" />

    @if (_showSaveDialog)
    {
        <div class="verso-modal-overlay" @onclick="CancelSaveDialog">
            <div class="verso-modal" @onclick:stopPropagation="true">
                <div class="verso-modal-header">
                    <span class="verso-modal-title">Save Notebook As</span>
                    <button class="verso-modal-close" @onclick="CancelSaveDialog" title="Cancel">
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="4" y1="4" x2="12" y2="12"/><line x1="12" y1="4" x2="4" y2="12"/></svg>
                    </button>
                </div>
                <div class="verso-modal-body">
                    <label class="verso-modal-label" for="savePath">Save to:</label>
                    <input id="savePath" class="verso-modal-input"
                           @bind="_saveFilePath" @bind:event="oninput"
                           @onkeydown="OnSaveDialogKeyDown"
                           @ref="_saveDialogInput"
                           spellcheck="false"
                           autocomplete="off" />
                    <div class="verso-modal-hint">
                        Enter the full file path. The <code>.verso</code> extension will be added if missing.
                    </div>
                </div>
                <div class="verso-modal-footer">
                    <button class="verso-modal-btn verso-modal-btn--secondary"
                            @onclick="CancelSaveDialog">Cancel</button>
                    <button class="verso-modal-btn verso-modal-btn--primary"
                            @onclick="ConfirmSaveDialog"
                            disabled="@string.IsNullOrWhiteSpace(_saveFilePath)">Save</button>
                </div>
            </div>
        </div>
    }

    @if (_showExtensionConsent && _pendingConsentExtensions is not null)
    {
        <ExtensionConsentDialog IsVisible="true"
                                Extensions="_pendingConsentExtensions"
                                OnConsentResult="HandleExtensionConsentResult" />
    }

    @if (_showInputDialog && _pendingInputRequest is not null)
    {
        <NotebookInputDialog IsVisible="true"
                             Request="_pendingInputRequest"
                             OnSubmit="HandleInputSubmitted"
                             OnCancel="HandleInputCancelled" />
    }

    @if (_error is not null)
    {
        <div class="verso-error-banner">
            <span>@_error</span>
            <button @onclick="() => _error = null">Dismiss</button>
        </div>
    }

    @if (_statusMessage is not null)
    {
        <div class="verso-status-banner">
            <span>@_statusMessage</span>
        </div>
    }

    @if (!Service.IsLoaded)
    {
        <div class="verso-welcome">
            <h1>Verso Notebook</h1>
            <p>Create a new notebook or open an existing <code>.verso</code>, <code>.ipynb</code>, or <code>.md</code> file to get started.</p>
            <button class="verso-welcome-btn" @onclick="HandleNew">New Notebook</button>
        </div>
    }
    else
    {
        <div class="verso-notebook-body">
            <div class="verso-notebook-main">
                <CascadingValue Value="@CellContext" IsFixed="false">
                    <LayoutRenderer @key="Service.ActiveLayoutKey"
                                    Service="Service"
                                    IsolatedRenderer="@RenderIsolatedLayout" />
                </CascadingValue>
            </div>

            <div class="verso-panel-container">
                @if (_activePanel is not null)
                {
                    <div class="verso-panel-content" @ref="_panelContentEl" style="width:@(_panelWidth)px">
                        <div class="verso-panel-resize-handle" @ref="_resizeHandle"></div>
                        <div class="verso-panel-header">
                            <span class="verso-panel-title">@PanelDisplayNames.For(_activePanel)</span>
                            <button class="verso-panel-minimize" @onclick="CollapsePanel" title="Collapse panel">&#x203A;</button>
                        </div>
                        <div class="verso-panel-body">
                            @if (_activePanel == "metadata")
                            {
                                <MetadataPanel Service="Service" />
                            }
                            else if (_activePanel == "extensions")
                            {
                                <ExtensionPanel Service="Service" />
                            }
                            else if (_activePanel == "variables")
                            {
                                <VariableExplorer Service="Service" />
                            }
                            else if (_activePanel == "settings")
                            {
                                <SettingsPanel Service="Service" />
                            }
                            else if (_activePanel == "properties")
                            {
                                <CellPropertiesPanel Service="Service" SelectedCellId="_selectedCellId" />
                            }
                        </div>
                    </div>
                }

                <div class="verso-panel-strip">
                    <button class="verso-panel-strip-tab @(_activePanel == "metadata" ? "verso-panel-strip-tab--active" : "")"
                            @onclick='() => TogglePanel("metadata")' title="Metadata">
                        <svg class="verso-panel-strip-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="1.5" width="10" height="13" rx="1"/>
                            <line x1="5.5" y1="5" x2="10.5" y2="5"/>
                            <line x1="5.5" y1="7.5" x2="10.5" y2="7.5"/>
                            <line x1="5.5" y1="10" x2="8.5" y2="10"/>
                        </svg>
                        <span>Metadata</span>
                    </button>
                    <button class="verso-panel-strip-tab @(_activePanel == "extensions" ? "verso-panel-strip-tab--active" : "")"
                            @onclick='() => TogglePanel("extensions")' title="Extensions">
                        <svg class="verso-panel-strip-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6.5 2.5h3v3h3v3h-3v3h-3v-3h-3v-3h3z"/>
                        </svg>
                        <span>Extensions</span>
                    </button>
                    <button class="verso-panel-strip-tab @(_activePanel == "variables" ? "verso-panel-strip-tab--active" : "")"
                            @onclick='() => TogglePanel("variables")' title="Variables">
                        <svg class="verso-panel-strip-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4.5 2.5c-1.5 0-2 1-2 2s1 1.5 1 2.5-.5 1-1 1.5c.5.5 1 .5 1 1.5s-1 1.5-1 2.5.5 2 2 2"/>
                            <path d="M11.5 2.5c1.5 0 2 1 2 2s-1 1.5-1 2.5.5 1 1 1.5c-.5.5-1 .5-1 1.5s1 1.5 1 2.5-.5 2-2 2"/>
                            <line x1="6.5" y1="6" x2="9.5" y2="10"/>
                            <line x1="6.5" y1="10" x2="9.5" y2="6"/>
                        </svg>
                        <span>Variables</span>
                    </button>
                    <button class="verso-panel-strip-tab @(_activePanel == "settings" ? "verso-panel-strip-tab--active" : "")"
                            @onclick='() => TogglePanel("settings")' title="Settings">
                        <svg class="verso-panel-strip-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="8" cy="8" r="2.5"/>
                            <path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.1 3.1l1.4 1.4M11.5 11.5l1.4 1.4M3.1 12.9l1.4-1.4M11.5 4.5l1.4-1.4"/>
                        </svg>
                        <span>Settings</span>
                    </button>
                    @if (Service.ActiveLayoutSupportsPropertiesPanel)
                    {
                        <button class="verso-panel-strip-tab @(_activePanel == "properties" ? "verso-panel-strip-tab--active" : "")"
                                @onclick='() => TogglePanel("properties")' title="Properties">
                            <svg class="verso-panel-strip-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="2" y1="4" x2="10" y2="4"/>
                                <line x1="2" y1="8" x2="14" y2="8"/>
                                <line x1="2" y1="12" x2="8" y2="12"/>
                                <circle cx="12" cy="4" r="1.5"/>
                                <circle cx="5" cy="12" r="1.5"/>
                                <circle cx="10" cy="8" r="1.5" fill="none"/>
                            </svg>
                            <span>Properties</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Guid? _selectedCellId;
    // Set to the cell whose editor currently has focus (edit mode); null in command mode.
    private Guid? _editingCellId;
    // True after a single command-mode "d"; a second "d" deletes the cell (Jupyter "dd").
    private bool _awaitingSecondDelete;
    private Guid? _executingCellId;
    private HashSet<Guid> _collapsedSections = new();
    private string? _error;
    private string? _statusMessage;
    private CancellationTokenSource? _statusCts;
    private string? _activePanel;
    private int _panelWidth = 300;
    private DotNetObjectReference<NotebookPage>? _panelResizeRef;
    private DotNetObjectReference<NotebookPage>? _cellInteractRef;
    private DotNetObjectReference<NotebookPage>? _cellDragRef;
    private DotNetObjectReference<NotebookPage>? _layoutInteractRef;
    private ElementReference _resizeHandle;
    private ElementReference _panelContentEl;
    private bool _panelResizeInitialized;
    private bool _showSaveDialog;
    private string _saveFilePath = "";
    private bool _hasNativeHandle;
    private ElementReference _saveDialogInput;
    private bool _showExtensionConsent;
    private IReadOnlyList<ExtensionConsentInfo>? _pendingConsentExtensions;
    private bool _showInputDialog;
    private ServerInputRequest? _pendingInputRequest;
    private bool _executionInProgress;
    private Timer? _autoSaveTimer;
    private bool _userPrefsApplied;
    private bool _restoringPrefs;
    private Toolbar? _toolbar;
    private bool _showDiffView;
    private NotebookDiffResult? _diffResult;
    private bool _showDiffSourcePicker;
    private string _diffSourcePickerKind = "gitRef";
    private string? _diffErrorMessage;
    // False until the first interactive render. Prerendering runs event handlers too
    // (e.g. required-extension loads fire status events), and JS interop before the
    // circuit exists throws InvalidOperationException rather than JSException.
    private bool _hasRendered;
    [SupplyParameterFromQuery(Name = "recover")]
    public string? RecoverPath { get; set; }

    private string MonacoThemeName =>
        Service.ActiveThemeKind == ThemeKind.Dark ? "vs-dark" : "vs";

    private sealed class RecoveryState
    {
        public string FilePath { get; set; } = "";
        public string Content { get; set; } = "";
        public long Timestamp { get; set; }
    }

    protected override void OnInitialized()
    {
        // OnCellExecuted now fires per cell from Scaffold's kernel execution thread,
        // so StateHasChanged must be marshalled onto the dispatcher.
        Service.OnCellExecuted += HandleCellExecutedRefresh;
        Service.OnCellExecuting += HandleCellExecutingEvent;
        Service.OnCellExecutionCompleted += HandleCellExecutedEvent;
        Service.OnNotebookChanged += StateHasChanged;
        Service.OnLayoutChanged += HandleLayoutChanged;
        Service.OnThemeChanged += HandleThemeChanged;
        Service.OnExtensionStatusChanged += HandleExtensionStatusChanged;
        Service.OnVariablesChanged += HandleVariablesChanged;
        Service.OnSettingsChanged += HandleSettingsChanged;
        Service.OnOutputUpdated += HandleOutputUpdated;
        Service.OnRequiredExtensionsUnavailable += HandleExtensionsUnavailable;
        Service.OnKernelRestarting += HandleKernelRestartingForDiff;
        Service.OnDiffRequested += HandleDiffRequested;

        if (Service is ServerNotebookService serverService)
        {
            serverService.OnExtensionConsentRequested += HandleExtensionConsentRequested;
            serverService.OnInputRequested += HandleInputRequested;
            // Hand the service the live collapsed-section set so a custom layout can fold sections
            // (including when switching to one with a section already collapsed). The set is shared
            // by reference; toggles re-assign it to trigger a layout re-render.
            serverService.CollapsedSections = _collapsedSections;
        }
    }

    private void HandleCellExecutedRefresh()
    {
        // Marshal to the dispatcher; callers may be on a kernel worker thread.
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleCellExecutingEvent(Guid cellId)
    {
        // Scaffold fires this on the kernel's execution thread. Marshal the
        // state mutation and render onto Blazor's dispatcher together.
        _ = InvokeAsync(() =>
        {
            _executingCellId = cellId;
            StateHasChanged();
        });
    }

    private void HandleCellExecutedEvent(Guid cellId)
    {
        _ = InvokeAsync(() =>
        {
            if (_executingCellId == cellId)
                _executingCellId = null;
            StateHasChanged();
        });
    }

    protected override async Task OnInitializedAsync()
    {
        // Primary recovery path: file path passed via URL query string.
        // This works even if the interactive circuit hasn't established yet
        // (runs during prerendering), so the user sees the notebook immediately.
        if (!string.IsNullOrEmpty(RecoverPath) && File.Exists(RecoverPath))
        {
            try
            {
                await Service.OpenAsync(RecoverPath);
                _selectedCellId = InitialCellSelection();
            }
            catch (Exception ex)
            {
                _error = $"Session recovery failed: {ex.Message}";
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _hasRendered = true;
            _cellInteractRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("versoCellInteract.register", _cellInteractRef);

            _cellDragRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("versoCellDrag.init", _cellDragRef);

            _layoutInteractRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("versoLayoutInteract.register", _layoutInteractRef);

            await SyncMonacoThemeAsync();

            // Clean URL query param and sessionStorage after query-param recovery
            if (RecoverPath is not null)
            {
                try { await JS.InvokeVoidAsync("history.replaceState", null, "", "/"); } catch { }
                try { await JS.InvokeVoidAsync("versoRecovery.clearState"); } catch { }
            }

            // Fallback: recover unsaved notebooks from sessionStorage (requires circuit)
            if (!Service.IsLoaded)
                await TryRecoverSessionAsync();

            await ApplyUserPreferencesAsync();

            StartAutoSaveTimer();
        }

        if (_activePanel is not null && !_panelResizeInitialized)
        {
            _panelResizeInitialized = true;
            _panelResizeRef ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("versoPanel.initResize", _resizeHandle, _panelContentEl, _panelResizeRef, 200, 600);
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        else if (_activePanel is null)
        {
            _panelResizeInitialized = false;
        }
    }

    private async Task TryRecoverSessionAsync()
    {
        try
        {
            var state = await JS.InvokeAsync<RecoveryState?>("versoRecovery.getState");
            if (state is null) return;

            // Ignore stale recovery data (older than 24 hours)
            var ageMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - state.Timestamp;
            if (ageMs > 86_400_000) // 24 hours
            {
                await JS.InvokeVoidAsync("versoRecovery.clearState");
                return;
            }

            await JS.InvokeVoidAsync("versoMonaco.waitForReady");

            if (!string.IsNullOrEmpty(state.FilePath) && File.Exists(state.FilePath))
            {
                await Service.OpenAsync(state.FilePath);
            }
            else if (!string.IsNullOrEmpty(state.Content))
            {
                await Service.OpenFromContentAsync("recovery.verso", state.Content);
            }
            else
            {
                await JS.InvokeVoidAsync("versoRecovery.clearState");
                return;
            }

            _selectedCellId = InitialCellSelection();
            await SyncMonacoThemeAsync();
            await JS.InvokeVoidAsync("versoRecovery.clearState");
            StateHasChanged();
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        catch (Exception ex)
        {
            _error = $"Session recovery failed: {ex.Message}";
            try { await JS.InvokeVoidAsync("versoRecovery.clearState"); } catch { }
        }
    }

    private async Task ApplyUserPreferencesAsync()
    {
        if (_userPrefsApplied) return;

        // Themes/extensions aren't available until a notebook is loaded
        if (Service.AvailableThemes.Count == 0) return;

        _restoringPrefs = true;
        try
        {
            var allExtIds = Service.Extensions.Select(e => e.ExtensionId).ToHashSet();

            var disabledIds = await JS.InvokeAsync<string[]?>("versoUserPrefs.getDisabledExtensions");
            if (disabledIds is not null)
            {
                foreach (var id in disabledIds)
                {
                    if (allExtIds.Contains(id))
                        await Service.DisableExtensionAsync(id);
                }

                // Scrub stale IDs that no longer match any loaded extension
                var cleaned = disabledIds.Where(allExtIds.Contains).ToArray();
                if (cleaned.Length != disabledIds.Length)
                    await JS.InvokeVoidAsync("versoUserPrefs.setDisabledExtensions", (object)cleaned);
            }

            var themeId = await JS.InvokeAsync<string?>("versoUserPrefs.getTheme");
            var available = Service.AvailableThemes.Select(t => t.ThemeId).ToHashSet();
            if (themeId is not null && Service.ActiveThemeId != themeId && available.Contains(themeId))
            {
                await Service.SwitchThemeAsync(themeId);
            }
            else if (themeId is not null && !available.Contains(themeId))
            {
                // Stored theme no longer exists — clear it so the default sticks
                await JS.InvokeVoidAsync("versoUserPrefs.setTheme", Service.ActiveThemeId ?? "");
            }

            _userPrefsApplied = true;
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        finally
        {
            _restoringPrefs = false;
        }
    }

    private void StartAutoSaveTimer()
    {
        _autoSaveTimer = new Timer(AutoSaveCallback, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async void AutoSaveCallback(object? state)
    {
        try
        {
            if (!Service.IsLoaded) return;

            var content = await Service.GetSerializedContentAsync();
            if (content is null) return;

            await InvokeAsync(async () =>
            {
                await JS.InvokeVoidAsync("versoRecovery.saveState", Service.FilePath ?? "", content);
            });
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { }
    }

    private void HandleLayoutChanged()
    {
        if (_activePanel == "properties" && !Service.ActiveLayoutSupportsPropertiesPanel)
            _activePanel = null;

        _ = InvokeAsync(StateHasChanged);
    }

    // Theme/extension handlers do real async work before re-rendering. They stay async void
    // (event-handler shape) but guard the whole body: a post-await ObjectDisposedException or
    // JSDisconnectedException during rapid open/close would otherwise escape to the sync
    // context and silently drop the Blazor circuit. Mirrors AutoSaveCallback.
    // JS interop is additionally gated on _hasRendered: during prerender it throws
    // InvalidOperationException, which none of these catches cover, and an escape from
    // an async void takes down the whole process.
    private async void HandleThemeChanged()
    {
        try
        {
            if (_hasRendered)
            {
                await SyncMonacoThemeAsync();
                if (!_restoringPrefs)
                {
                    try
                    {
                        if (Service.ActiveThemeId is not null)
                            await JS.InvokeVoidAsync("versoUserPrefs.setTheme", Service.ActiveThemeId);
                    }
                    catch (JSDisconnectedException) { }
                    catch (JSException) { }
                }
            }
            await InvokeAsync(StateHasChanged);
            if (_hasRendered)
            {
                // Snapshot the rendered CSS variables so the next page load can apply them early
                try { await JS.InvokeVoidAsync("versoUserPrefs.saveThemeSnapshot"); }
                catch (JSDisconnectedException) { }
                catch (JSException) { }
            }
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { }
    }

    private async void HandleExtensionStatusChanged()
    {
        try
        {
            if (_hasRendered && !_restoringPrefs)
            {
                try
                {
                    var disabledIds = Service.Extensions
                        .Where(e => e.Status == ExtensionStatus.Disabled)
                        .Select(e => e.ExtensionId)
                        .ToArray();
                    await JS.InvokeVoidAsync("versoUserPrefs.setDisabledExtensions", (object)disabledIds);
                }
                catch (JSDisconnectedException) { }
                catch (JSException) { }
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { }
    }

    private void HandleVariablesChanged() => _ = InvokeAsync(StateHasChanged);

    private void HandleSettingsChanged() => _ = InvokeAsync(StateHasChanged);

    private async void HandleExtensionConsentRequested()
    {
        if (Service is ServerNotebookService serverService)
        {
            _pendingConsentExtensions = serverService.PendingConsentExtensions;
            _showExtensionConsent = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void HandleExtensionConsentResult(bool approved)
    {
        _showExtensionConsent = false;
        _pendingConsentExtensions = null;

        if (Service is ServerNotebookService serverService)
            serverService.ResolveConsentResult(approved);
    }

    private void HandleInputRequested()
    {
        _ = InvokeAsync(() =>
        {
            if (Service is ServerNotebookService serverService)
            {
                _pendingInputRequest = serverService.PendingInputRequest;
                _showInputDialog = _pendingInputRequest is not null;
                StateHasChanged();
            }
        });
    }

    private void HandleInputSubmitted(string value)
    {
        _showInputDialog = false;
        _pendingInputRequest = null;

        if (Service is ServerNotebookService serverService)
            serverService.ResolveInputResult(value, cancelled: false);
    }

    private void HandleInputCancelled()
    {
        _showInputDialog = false;
        _pendingInputRequest = null;

        if (Service is ServerNotebookService serverService)
            serverService.ResolveInputResult(null, cancelled: true);
    }

    private void HandleOutputUpdated() => _ = InvokeAsync(StateHasChanged);

    [JSInvokable]
    public async Task<string?> OnCellInteract(string cellId, string extensionId, string interactionType, string payloadJson, string? outputBlockId)
    {
        if (!Guid.TryParse(cellId, out var cellGuid))
            return null;

        return await Service.HandleCellInteractionAsync(
            cellGuid, extensionId, interactionType, payloadJson, outputBlockId, CellRegion.Output);
    }

    [JSInvokable]
    public async Task<string?> OnLayoutInteract(
        string extensionId, string layoutId, string? frameInstanceId,
        string interactionType, string payloadJson, string? targetId)
    {
        await Service.LayoutInteractAsync(
            extensionId, layoutId, interactionType, payloadJson ?? string.Empty,
            frameInstanceId, targetId);
        return null;
    }

    private async Task SyncMonacoThemeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("versoMonaco.setTheme", MonacoThemeName);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private void TogglePanel(string panelId)
    {
        if (_activePanel == panelId)
            _activePanel = null;
        else
            _activePanel = panelId;
    }

    private void CollapsePanel()
    {
        _activePanel = null;
    }

    // A layout that advertises no CellEdit capability (e.g. Presentation, Dashboard) is a
    // read-only display surface: cells are shown for consumption but never selected or edited.
    // Reporting no selection there keeps render-only and collapse-on-execute cells in their
    // preview (output-visible) state instead of flipping to a hidden editor when their output
    // is clicked, which would make the output appear to vanish.
    private bool ActiveLayoutSupportsCellEditing
        => Service.LayoutCapabilities.HasFlag(LayoutCapabilities.CellEdit);

    private NotebookCellContext CellContext => new()
    {
        SelectedCellId = ActiveLayoutSupportsCellEditing ? _selectedCellId : null,
        ExecutingCellId = _executingCellId,
        IsRunDisabled = _executionInProgress,
        CollapsedSections = _collapsedSections,
        OnRunCell = EventCallback.Factory.Create<Guid>(this, HandleRunCell),
        OnCancelCell = EventCallback.Factory.Create<Guid>(this, HandleCancelCell),
        OnDeleteCell = EventCallback.Factory.Create<Guid>(this, HandleDeleteCell),
        OnSelectCell = EventCallback.Factory.Create<Guid>(this, HandleSelectCell),
        OnMoveUp = EventCallback.Factory.Create<Guid>(this, HandleMoveUp),
        OnMoveDown = EventCallback.Factory.Create<Guid>(this, HandleMoveDown),
        OnToggleSection = EventCallback.Factory.Create<Guid>(this, HandleToggleSection),
        OnSourceChanged = EventCallback.Factory.Create<(Guid, string)>(this, HandleSourceChanged),
        OnCellAction = EventCallback.Factory.Create<(Guid, string)>(this, HandleCellAction),
        OnCellTypeChanged = EventCallback.Factory.Create<(Guid, string)>(this, HandleCellTypeChanged),
        OnCellLanguageChanged = EventCallback.Factory.Create<(Guid, string)>(this, HandleCellLanguageChanged),
        OnInsertCell = EventCallback.Factory.Create<(int, string)>(this, args => HandleInsertCell(args.Item1, args.Item2)),
        OnAddCell = EventCallback.Factory.Create<string>(this, HandleAddCell),
        OnCellListClick = EventCallback.Factory.Create(this, HandleCellListClick),
    };

