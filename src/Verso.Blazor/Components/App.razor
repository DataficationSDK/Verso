@using System.Reflection
@using System.Globalization
@using System.Text.Json
@using Verso.Blazor.Shared.Resources

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/png" href="icon.png" />
    <link rel="stylesheet" href="_content/Verso.Blazor.Shared/app.css?v=@CacheBuster" />
    <HeadOutlet @rendermode="InteractiveServer" />
    <script>
        try {
            var css = localStorage.getItem('verso-user-theme-css');
            if (css) {
                var s = document.createElement('style');
                s.id = 'verso-early-theme';
                s.textContent = css;
                document.head.appendChild(s);
            }
        } catch(e) {}
    </script>
</head>
<body>
    <Routes @rendermode="InteractiveServer" />

    <script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js"></script>
    <script src="_content/Verso.Blazor.Shared/js/monaco-interop.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/custom-layout-interop.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/verso-layout-assets.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/dashboard-interop.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/layout-interact-interop.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/verso-inline-layout-bridge.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/verso-layout-frame.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/panel-resize-interop.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/file-download-interop.js?v=@CacheBuster"></script>
    <script src="js/save-dialog-interop.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/mermaid-interop.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/katex-interop.js?v=@CacheBuster"></script>
    <script src="js/recovery-interop.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/cell-interact-interop.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/panel-interact-interop.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/parameters-interop.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/cell-drag-interop.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/user-prefs-interop.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/tag-input-interop.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/widget-interop.js?v=@CacheBuster"></script>
    <script src="_content/Verso.Blazor.Shared/js/tooltip.js?v=@CacheBuster"></script>
    <div id="verso-reconnect-overlay" style="display:none">
        <div class="verso-reconnect-box">
            <div class="verso-spinner verso-spinner--large"></div>
            <h3 id="verso-reconnect-title">@UI.Reconnect_Title</h3>
            <p id="verso-reconnect-message">@UI.Reconnect_Message</p>
            <button id="verso-reconnect-reload" style="display:none" onclick="location.reload()">@UI.Reconnect_Reload</button>
        </div>
    </div>

    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        (() => {
            const overlay = document.getElementById('verso-reconnect-overlay');
            const title = document.getElementById('verso-reconnect-title');
            const message = document.getElementById('verso-reconnect-message');
            const reloadBtn = document.getElementById('verso-reconnect-reload');
            const pageLoadTime = Date.now();
            let isDisconnected = false;
            let disconnectTimer = null;

            function recoverAndReload() {
                title.textContent = @Js(UI.Reconnect_RecoveringTitle);
                message.textContent = @Js(UI.Reconnect_RecoveringMessage);
                reloadBtn.style.display = 'none';
                overlay.style.display = 'flex';

                // Pass file path via URL so the server can recover during
                // component initialization — no interactive circuit needed.
                var state = window.versoRecovery.getState();
                var url = '/';
                if (state && state.filePath) {
                    url = '/?recover=' + encodeURIComponent(state.filePath);
                }
                setTimeout(() => { window.location.href = url; }, 1000);
            }

            Blazor.start({
                circuit: {
                    reconnectionOptions: {
                        maxRetries: 30,
                        retryIntervalMilliseconds: (previousAttempts) =>
                            previousAttempts < 10 ? 1000
                            : previousAttempts < 20 ? 3000
                            : 5000
                    },
                    reconnectionHandler: {
                        onConnectionDown(options, error) {
                            isDisconnected = true;

                            // Don't show the overlay for connection failures during
                            // initial page load (e.g. recovery reload where the server
                            // needs a moment to clean up the old circuit).
                            if (Date.now() - pageLoadTime < 10000) return;

                            overlay.style.display = 'flex';
                            title.textContent = @Js(UI.Reconnect_Title);
                            message.textContent = @Js(UI.Reconnect_Message);
                            reloadBtn.style.display = 'none';

                            // Foreground fallback: if the tab stays visible, reload after 2 min
                            if (!disconnectTimer) {
                                disconnectTimer = setTimeout(recoverAndReload, 120000);
                            }
                        },
                        onConnectionUp() {
                            isDisconnected = false;
                            overlay.style.display = 'none';
                            if (disconnectTimer) {
                                clearTimeout(disconnectTimer);
                                disconnectTimer = null;
                            }
                        }
                    }
                }
            });

            // When the user returns to a backgrounded tab, browsers will have
            // throttled/suspended setTimeout, so the foreground timer won't have
            // fired. Detect tab re-activation and reload immediately if disconnected.
            document.addEventListener('visibilitychange', () => {
                if (document.visibilityState === 'visible' && isDisconnected
                    && Date.now() - pageLoadTime > 10000) {
                    recoverAndReload();
                }
            });
        })();
    </script>
</body>
</html>

@code {
    // The overlay is written twice: once as markup for the first paint, and once by the
    // script that rewrites it when the connection drops. Both read the same resources, so
    // the script needs its text as a quoted JavaScript string rather than as page content.
    private static MarkupString Js(string value) => new(JsonSerializer.Serialize(value));

    private static readonly string CacheBuster = GetCacheBuster();

    private static string GetCacheBuster()
    {
        var info = typeof(App).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()
            ?.InformationalVersion;

        // Published builds include a commit hash suffix (e.g. "1.0.0+abc123") which
        // changes per build. For local dev builds without a suffix, fall back to the
        // assembly's last-write time so every recompile busts the cache.
        if (info is not null && info.Contains('+'))
            return info.Split('+')[1];

        var location = typeof(App).Assembly.Location;
        if (!string.IsNullOrEmpty(location) && File.Exists(location))
            return new FileInfo(location).LastWriteTimeUtc.Ticks.ToString();

        return DateTimeOffset.UtcNow.Ticks.ToString();
    }
}
