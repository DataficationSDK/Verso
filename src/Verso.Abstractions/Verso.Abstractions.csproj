<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(VersoLibTargetFrameworks)</TargetFrameworks>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Verso.Abstractions</PackageId>
    <Title>Verso Abstractions</Title>
    <Description>Pure interfaces and types for the Verso extensible notebook platform.</Description>
    <!--
      Fails the build when the public surface breaks compatibility with the last published
      package, so a change that would break existing extensions is caught before release.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.2.3</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!--
    1.3.0 drops net8.0 on purpose. Without this, validation reports the dropped target framework
    (PKV006). Remove this item when the baseline moves to a version that no longer has net8.0.
  -->
  <ItemGroup>
    <PackageValidationBaselineFrameworkToIgnore Include="net8.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
