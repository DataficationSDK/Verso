@using System.Diagnostics.CodeAnalysis
@using System.Reflection
@using System.Text
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject INotebookService NotebookService

@if (_css is not null)
{
    <style id="verso-theme">@((MarkupString)_css)</style>
}

@code {
    [Parameter] public ThemeData? Theme { get; set; }

    private string? _css;
    private string? _lastDispatchedCss;

    protected override void OnParametersSet()
    {
        // When Theme is null (no notebook loaded), render nothing so that
        // an early-theme <style> injected from localStorage isn't overwritten.
        _css = Theme is not null ? BuildCss() : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Notify layout-author scripts subscribed via window.verso.layout's
        // onThemeChange() when the rendered CSS payload actually changes. The bridge
        // converts the call into a CustomEvent on window so inline-layout scripts get
        // a structured payload instead of polling computed style.
        if (_css is null || string.Equals(_css, _lastDispatchedCss, StringComparison.Ordinal))
            return;
        _lastDispatchedCss = _css;
        try
        {
            await JS.InvokeVoidAsync(
                "verso.theme.dispatchChange",
                BuildThemeKind(),
                BuildTokenPayload());
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private string? BuildThemeKind()
    {
        // Surface the active theme's kind so inline-layout scripts that branch on it match the
        // isolated-iframe path (which already sends kind via LayoutThemeBundle) and the VS Code
        // host (which posts kind on its own channel). Tokens remain the recommended path; this
        // only fills the previously-always-null kind. Null kind stays null (KindToWire would
        // otherwise coerce it to "light").
        var kind = NotebookService.ActiveThemeKind;
        return kind is null ? null : LayoutThemeBundleBuilder.KindToWire(kind);
    }

    [DynamicDependency(DynamicallyAccessedMemberTypes.PublicProperties, typeof(ThemeColorTokens))]
    [DynamicDependency(DynamicallyAccessedMemberTypes.PublicProperties, typeof(ThemeTypography))]
    [DynamicDependency(DynamicallyAccessedMemberTypes.PublicProperties, typeof(ThemeSpacing))]
    private Dictionary<string, string> BuildTokenPayload()
    {
        // Mirror the dotted-name palette used by LayoutThemeBundle so iframe-isolation
        // and inline subscribers see the same keys. The bridge consumer can also call
        // getThemeToken() to resolve a CSS custom property directly.
        var tokens = new Dictionary<string, string>(StringComparer.Ordinal);
        if (Theme is null) return tokens;

        var colors = Theme.Colors;
        foreach (var prop in typeof(ThemeColorTokens).GetProperties(BindingFlags.Public | BindingFlags.Instance))
        {
            if (prop.PropertyType != typeof(string)) continue;
            var value = (string?)prop.GetValue(colors);
            if (value is null) continue;
            tokens[ToDottedName(prop.Name)] = value;
        }
        return tokens;
    }

    private static string ToDottedName(string name)
    {
        // Convert PascalCase property name to dot.case (e.g. "BgDefault" -> "bg.default").
        var sb = new StringBuilder();
        for (int i = 0; i < name.Length; i++)
        {
            var c = name[i];
            if (char.IsUpper(c))
            {
                if (i > 0) sb.Append('.');
                sb.Append(char.ToLowerInvariant(c));
            }
            else
            {
                sb.Append(c);
            }
        }
        return sb.ToString();
    }

    // The block itself is built in Verso.Abstractions, next to the token records, because the
    // HTML export needs the same one. While the two kept separate copies they drifted apart,
    // and the numbers in them were written in the reader's language, which CSS cannot read.
    private string BuildCss() =>
        ThemeCss.BuildRootBlock(Theme?.Colors, Theme?.Typography, Theme?.Spacing, Theme?.Elevation);
}
