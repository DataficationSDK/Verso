@implements IAsyncDisposable
@inject IJSRuntime JS

@* Filled by the interop, which splices its own script in ahead of the widget before handing
   the whole document to the frame.

   An iframe's title is its accessible name rather than a hover tooltip, so this one stays a
   title attribute where every other control moved to data-verso-tip. *@
<iframe @ref="_frame"
        class="verso-widget-frame"
        title="@UI.Widget_FrameTitle"
        sandbox="allow-scripts"
        data-verso-live="@(ChannelId is { Length: > 0 } ? "true" : "false")"
        style="width:100%;border:0;display:block"></iframe>
@* Shown only when the frame beside it is not live, by a sibling rule in the stylesheet, so a
   channel closing needs nothing here: the interop marks the frame and this appears. Being
   display:none while the widget is live is also what keeps it out of the accessibility tree
   until it is true. *@
<p class="verso-widget-inert" role="note">@UI.Widget_InertNotice</p>

@code {
    /// <summary>The self-contained widget document to draw in the frame.</summary>
    [Parameter, EditorRequired] public string Document { get; set; } = string.Empty;

    /// <summary>
    /// The output channel this document talks over, when the output has one. Null for a widget
    /// drawn from saved state or produced by a host with nothing to talk back to, which is drawn
    /// exactly the same way and simply has no return leg.
    /// </summary>
    /// <remarks>
    /// Handed to the interop at mount rather than written into the document, so it is never part
    /// of what a save would write and a frame can only ever address the channel it was given.
    /// </remarks>
    [Parameter] public string? ChannelId { get; set; }

    private ElementReference _frame;
    private int? _handle;
    private bool _mounted;

    // Mounted once. The document is fixed for the lifetime of this component: a re-run
    // produces a different output object, and the caller keys on it so a new frame is built
    // rather than this one being refilled.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_mounted || string.IsNullOrEmpty(Document)) return;
        _mounted = true;

        try
        {
            // The theme kind is left to the interop, which reads it where the frame sits; the
            // argument is present only because the channel id follows it.
            _handle = await JS.InvokeAsync<int?>("versoWidget.mount", _frame, Document, null, ChannelId);
        }
        catch (JSException)
        {
            // A host without the interop loaded shows an empty frame rather than failing the
            // cell, which has already run and whose other outputs are worth keeping.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_handle is null) return;

        try
        {
            await JS.InvokeVoidAsync("versoWidget.detach", _handle);
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }
}
