@using System.Net
@using System.Text
@using System.Text.Json
@inject IJSRuntime JS

@for (var outputIndex = 0; outputIndex < Outputs.Count; outputIndex++)
{
    var index = outputIndex;
    var output = Outputs[index];
    @* Each output renders inside its own ErrorBoundary so one payload that throws during render
       degrades to a single inline error card while sibling outputs keep rendering. The output
       object is part of the boundary key (CellOutput is a record with value equality, so the
       position disambiguates duplicates); replacing an output via re-run or an interaction update
       therefore recreates the boundary and recovers without user action. Retry bumps
       _retryVersion, which rotates every key and re-attempts all outputs. *@
    <ErrorBoundary @key="(index, output, _retryVersion)">
        <ChildContent>
            @if (output.IsError)
            {
                <div class="verso-output verso-output--error">
                    <div class="verso-output-error-name">@(output.ErrorName ?? UI.Output_Error)</div>
                    <pre class="verso-output-error-content">@output.Content</pre>
                    @if (ExtendedMimeTypes && output.ErrorStackTrace is not null)
                    {
                        <pre class="verso-output-error-stack">@output.ErrorStackTrace</pre>
                    }
                </div>
            }
            else if (output.MimeType == CellOutput.ProgressMimeType)
            {
                @* A progress bar redrawn several times a second must not be announced on every
                   frame, so the value updates silently and only the label is read. *@
                var progress = ReadProgress(output.Content);
                <div class="verso-output verso-output--progress">
                    <div class="verso-progress-label">
                        <span>@progress.Activity</span>
                        @if (!string.IsNullOrEmpty(progress.Status))
                        {
                            <span class="verso-progress-status">@progress.Status</span>
                        }
                    </div>
                    <div class="verso-progress-track"
                         role="progressbar"
                         aria-label="@progress.Activity"
                         aria-valuemin="0"
                         aria-valuemax="100"
                         aria-valuenow="@(progress.Percent?.ToString() ?? null)">
                        <div class="verso-progress-fill@(progress.Percent is null ? " verso-progress-fill--indeterminate" : "")"
                             style="@(progress.Percent is null ? "" : $"width:{progress.Percent}%")"></div>
                    </div>
                </div>
            }
            @* Not gated on ExtendedMimeTypes, for the same reason the HTML branch below is not:
               the narrower renderer would otherwise fall through to the text branch and print a
               whole document into a <pre>. *@
            else if (output.MimeType == CellOutput.WidgetMimeType)
            {
                @* A widget is a whole document and gets its own frame. Keyed like the HTML
                   branch so a re-run builds a new frame rather than refilling this one, which
                   would leave the previous widget's code running inside it. *@
                <div class="verso-output verso-output--widget">
                    <WidgetFrame @key="(index, output)" Document="@output.Content" ChannelId="@output.LiveChannelId" />
                </div>
            }
            else if (ExtendedMimeTypes && output.MimeType == "text/x-verso-mermaid")
            {
                <div class="verso-output verso-output--html verso-mermaid-container">
                    <pre class="mermaid">@output.Content</pre>
                </div>
            }
            else if (output.MimeType == "text/html" || output.MimeType == "image/svg+xml")
            {
                @* @key forces Blazor to tear down and recreate the element when the output object
                   changes, rather than diffing MarkupString child nodes in place which can cause
                   removeChild errors when interactive elements (inputs, checkboxes) hold
                   browser-managed DOM state. CellOutput is a record (value equality), so the
                   position is part of the key: two identical outputs in one cell must not collide. *@
                <div @key="(index, output)" class="verso-output verso-output--html">
                    @((MarkupString)output.Content)
                </div>
            }
            else if (ExtendedMimeTypes && output.MimeType.StartsWith("image/"))
            {
                <div class="verso-output verso-output--html">
                    <img src="@($"data:{output.MimeType};base64,{output.Content}")" style="max-width:100%" />
                </div>
            }
            else if (ExtendedMimeTypes && output.MimeType == "application/json")
            {
                <div class="verso-output verso-output--html">
                    @((MarkupString)RenderJsonTree(output.Content))
                </div>
            }
            else if (ExtendedMimeTypes && output.MimeType == "text/csv")
            {
                <div class="verso-output verso-output--html">
                    @((MarkupString)RenderCsvTable(output.Content))
                </div>
            }
            else if (output.Channel == OutputChannel.Stderr)
            {
                @* Standard error is shown so it can be told apart from ordinary output, but it is
                   not a failure: progress bars, logging, and warnings all arrive here from
                   programs that are working correctly. The label carries the meaning on its own,
                   because colour is dropped when a notebook is printed. *@
                <div class="verso-output verso-output--stderr" role="note" aria-label="@UI.Output_StandardError">
                    <div class="verso-output-stderr-label">stderr</div>
                    <pre>@output.Content</pre>
                </div>
            }
            else
            {
                <div class="verso-output verso-output--text">
                    <pre>@output.Content</pre>
                </div>
            }
        </ChildContent>
        <ErrorContent Context="renderError">
            <div class="verso-output verso-output--error">
                <div class="verso-output-error-name">@UI.Output_RenderFailed</div>
                <pre class="verso-output-error-content">@renderError.Message</pre>
                <button class="verso-cell-btn verso-cell-btn--action" @onclick="RetryOutputRender" data-verso-tip="@UI.Output_RetryRender">@UI.Common_Retry</button>
            </div>
        </ErrorContent>
    </ErrorBoundary>
}

@code {
    /// <summary>The outputs to render, in order.</summary>
    [Parameter] public IReadOnlyList<CellOutput> Outputs { get; set; } = Array.Empty<CellOutput>();

    /// <summary>
    /// When true (the default), renders the full set of MIME handlers (mermaid, images, JSON
    /// trees, CSV tables, error stack traces). When false, replicates the narrower rendering
    /// used by non-editable cells: errors without stack traces, HTML and SVG, and plain text.
    /// </summary>
    [Parameter] public bool ExtendedMimeTypes { get; set; } = true;

    // Part of every per-output ErrorBoundary key; incrementing it recreates the boundaries so
    // Retry re-attempts rendering after an output has faulted.
    private int _retryVersion;

    private void RetryOutputRender() => _retryVersion++;

    private readonly record struct ProgressPayload(string Activity, string? Status, int? Percent, bool Done);

    /// <summary>
    /// Reads a progress payload. A malformed one still renders as an indeterminate bar rather than
    /// throwing, because a progress report is never worth failing a cell's rendering over.
    /// </summary>
    private static ProgressPayload ReadProgress(string content)
    {
        try
        {
            using var doc = JsonDocument.Parse(content);
            var root = doc.RootElement;

            var activity = root.TryGetProperty("activity", out var a) && a.ValueKind == JsonValueKind.String
                ? a.GetString() ?? UI.Output_Working
                : UI.Output_Working;
            var status = root.TryGetProperty("status", out var s) && s.ValueKind == JsonValueKind.String
                ? s.GetString()
                : null;
            int? percent = root.TryGetProperty("percent", out var p) && p.ValueKind == JsonValueKind.Number
                ? Math.Clamp(p.GetInt32(), 0, 100)
                : null;
            var done = root.TryGetProperty("done", out var d) && d.ValueKind == JsonValueKind.True;

            return new ProgressPayload(activity, status, done ? 100 : percent, done);
        }
        catch (JsonException)
        {
            return new ProgressPayload("Working", null, null, false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ExtendedMimeTypes && Outputs.Any(o => o.MimeType == "text/x-verso-mermaid"))
        {
            try { await JS.InvokeVoidAsync("versoMermaid.renderAll"); }
            catch (JSException) { }
        }
    }

    // --- MIME type renderers ---

    private static string RenderCsvTable(string content)
    {
        var sb = new StringBuilder();
        sb.Append("<style>");
        sb.Append(".verso-csv{border-collapse:collapse;width:100%;font-family:var(--verso-code-output-font-family,monospace);font-size:13px;");
        sb.Append("background:var(--vscode-editor-background,var(--verso-cell-output-background,#fff));");
        sb.Append("color:var(--vscode-editor-foreground,var(--verso-cell-output-foreground,#1e1e1e))}");
        sb.Append(".verso-csv th{padding:6px 12px;text-align:left;white-space:nowrap;");
        sb.Append("background:var(--vscode-editorWidget-background,var(--verso-cell-background,#f5f5f5));");
        sb.Append("border:1px solid var(--vscode-editorWidget-border,var(--verso-border-default,#e0e0e0));font-weight:600}");
        sb.Append(".verso-csv td{padding:4px 12px;");
        sb.Append("background:var(--vscode-editor-background,var(--verso-cell-output-background,#fff));");
        sb.Append("border:1px solid var(--vscode-editorWidget-border,var(--verso-border-default,#e0e0e0));white-space:nowrap}");
        sb.Append(".verso-csv tr:hover td{background:var(--vscode-list-hoverBackground,var(--verso-cell-hover-background,#f0f0f0))}");
        sb.Append("</style>");

        var lines = content.Split('\n', StringSplitOptions.RemoveEmptyEntries);
        if (lines.Length == 0) return $"<span>{WebUtility.HtmlEncode(UI.Output_EmptyCsv)}</span>";

        sb.Append("<div style='max-height:400px;overflow:auto;border:1px solid var(--vscode-editorWidget-border,#e0e0e0);border-radius:4px'>");
        sb.Append("<table class='verso-csv'>");

        for (int i = 0; i < lines.Length; i++)
        {
            var cells = ParseCsvLine(lines[i]);
            var tag = i == 0 ? "th" : "td";
            sb.Append("<tr>");
            foreach (var cell in cells)
                sb.Append($"<{tag}>{WebUtility.HtmlEncode(cell)}</{tag}>");
            sb.Append("</tr>");
        }

        sb.Append("</table></div>");
        return sb.ToString();
    }

    private static List<string> ParseCsvLine(string line)
    {
        var fields = new List<string>();
        var current = new StringBuilder();
        bool inQuotes = false;

        for (int i = 0; i < line.Length; i++)
        {
            var c = line[i];
            if (inQuotes)
            {
                if (c == '"' && i + 1 < line.Length && line[i + 1] == '"')
                {
                    current.Append('"');
                    i++;
                }
                else if (c == '"')
                {
                    inQuotes = false;
                }
                else
                {
                    current.Append(c);
                }
            }
            else if (c == '"')
            {
                inQuotes = true;
            }
            else if (c == ',')
            {
                fields.Add(current.ToString().Trim());
                current.Clear();
            }
            else
            {
                current.Append(c);
            }
        }

        fields.Add(current.ToString().Trim());
        return fields;
    }

    /// <summary>
    /// The count summarising a collapsed JSON object or list, escaped for the markup it goes into.
    /// </summary>
    /// <remarks>
    /// A translation of "{0} keys" can hold characters that mean something in HTML, and this
    /// output is built as a string rather than as markup, so it is encoded here rather than
    /// trusted.
    /// </remarks>
    private static string JsonCount(int count, string one, string other)
        => WebUtility.HtmlEncode(string.Format(Plural.Of(count, one, other), count));

    private static string RenderJsonTree(string content)
    {
        try
        {
            using var doc = JsonDocument.Parse(content);
            var sb = new StringBuilder();
            sb.Append("<style>");
            sb.Append(".verso-json{font-family:var(--verso-code-output-font-family,monospace);font-size:13px;");
            sb.Append("color:var(--vscode-editor-foreground,#1e1e1e);line-height:1.5}");
            sb.Append(".verso-json details{margin-left:16px}");
            sb.Append(".verso-json summary{cursor:pointer;list-style:none;user-select:none}");
            sb.Append(".verso-json summary::-webkit-details-marker{display:none}");
            sb.Append(".verso-json summary::before{content:'\\25B6';font-size:9px;margin-right:4px;");
            sb.Append("color:var(--vscode-descriptionForeground,#858585);display:inline-block;transition:transform 0.1s}");
            sb.Append(".verso-json details[open]>summary::before{transform:rotate(90deg)}");
            sb.Append(".verso-json .jk{color:var(--vscode-textLink-foreground,#0078d4)}");
            sb.Append(".verso-json .js{color:var(--vscode-debugTokenExpression-string,#a31515)}");
            sb.Append(".verso-json .jn{color:var(--vscode-debugTokenExpression-number,#098658)}");
            sb.Append(".verso-json .jb{color:var(--vscode-debugTokenExpression-boolean,#0000ff)}");
            sb.Append(".verso-json .jnull{color:var(--vscode-descriptionForeground,var(--verso-editor-line-number,#858585));font-style:italic}");
            sb.Append(".verso-json .jbrace{color:var(--vscode-editor-foreground,var(--verso-cell-output-foreground,#1e1e1e))}");
            sb.Append(".verso-json .jcount{color:var(--vscode-editor-foreground,var(--verso-cell-output-foreground,#1e1e1e));opacity:0.7}");
            sb.Append("</style>");
            sb.Append("<div class='verso-json'>");
            RenderJsonElement(sb, doc.RootElement, null, 0);
            sb.Append("</div>");
            return sb.ToString();
        }
        catch
        {
            return $"<pre>{WebUtility.HtmlEncode(content)}</pre>";
        }
    }

    private static void RenderJsonElement(StringBuilder sb, JsonElement element, string? key, int depth)
    {
        var keyHtml = key is not null ? $"<span class='jk'>\"{WebUtility.HtmlEncode(key)}\"</span>: " : "";

        switch (element.ValueKind)
        {
            case JsonValueKind.Object:
                var objProps = element.EnumerateObject().ToList();
                if (objProps.Count == 0)
                {
                    sb.Append($"<div>{keyHtml}<span class='jbrace'>{{}}</span></div>");
                }
                else
                {
                    sb.Append($"<details{(depth < 2 ? " open" : "")}>");
                    sb.Append($"<summary>{keyHtml}<span class='jbrace'>{{</span> <span class='jcount'>{JsonCount(objProps.Count, UI.Output_JsonKeys_One, UI.Output_JsonKeys_Other)}</span></summary>");
                    foreach (var prop in objProps)
                        RenderJsonElement(sb, prop.Value, prop.Name, depth + 1);
                    sb.Append($"<div><span class='jbrace'>}}</span></div></details>");
                }
                break;

            case JsonValueKind.Array:
                var items = element.EnumerateArray().ToList();
                if (items.Count == 0)
                {
                    sb.Append($"<div>{keyHtml}<span class='jbrace'>[]</span></div>");
                }
                else
                {
                    sb.Append($"<details{(depth < 2 ? " open" : "")}>");
                    sb.Append($"<summary>{keyHtml}<span class='jbrace'>[</span> <span class='jcount'>{JsonCount(items.Count, UI.Output_JsonItems_One, UI.Output_JsonItems_Other)}</span></summary>");
                    foreach (var item in items)
                        RenderJsonElement(sb, item, null, depth + 1);
                    sb.Append($"<div><span class='jbrace'>]</span></div></details>");
                }
                break;

            case JsonValueKind.String:
                sb.Append($"<div>{keyHtml}<span class='js'>\"{WebUtility.HtmlEncode(element.GetString())}\"</span></div>");
                break;

            case JsonValueKind.Number:
                sb.Append($"<div>{keyHtml}<span class='jn'>{element.GetRawText()}</span></div>");
                break;

            case JsonValueKind.True:
            case JsonValueKind.False:
                sb.Append($"<div>{keyHtml}<span class='jb'>{element.GetRawText()}</span></div>");
                break;

            case JsonValueKind.Null:
                sb.Append($"<div>{keyHtml}<span class='jnull'>null</span></div>");
                break;
        }
    }
}
