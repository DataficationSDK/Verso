@implements IDisposable
@inject IJSRuntime JS
@* One tooltip group for the whole bar: after the first hover, sweeping across the
   actions and the panel toggles answers without waiting again. *@
<div class="verso-toolbar" data-verso-tip-group @onclick="CloseAllDropdowns">
    @if (Service.IsLoaded)
    {
        @* Only worth a tooltip when the cluster is hiding something: a file name
           too long for the label, or more kernels than the one it names. *@
        <div class="verso-doc-info" data-verso-tip="@DocInfoTip" data-verso-tip-desc="@DocInfoTipDetail">
            <svg class="verso-doc-info-icon" viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 1.5h5L13 5.5v8a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1z"/><path d="M9 1.5V5.5h4"/></svg>
            <div class="verso-doc-info-text">
                <span class="verso-doc-info-name">@DocName</span>
                <span class="verso-doc-info-meta">@KernelLabel &middot; @CellCountLabel</span>
            </div>
        </div>

        @* The detail is the underlying cause of an error or a disconnect, which
           used to be concatenated onto the status with a colon. *@
        <div class="verso-kernel-status @KernelStatusClass"
             data-verso-tip="@KernelStatusText" data-verso-tip-desc="@KernelStatusDetail">
            <span class="verso-kernel-status-dot"></span>
            <span class="verso-kernel-status-text">@KernelStatusText</span>
        </div>

        <div class="verso-toolbar-separator"></div>
    }

    @if (!Service.IsEmbedded)
    {
        <div class="verso-toolbar-group">
            <button class="verso-toolbar-btn" @onclick="OnNew" data-verso-tip="@UI.Toolbar_NewNotebook">
                <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V6z"/><path d="M9 2v4h4"/><line x1="8" y1="9" x2="8" y2="13"/><line x1="6" y1="11" x2="10" y2="11"/></svg>
                @UI.Toolbar_New
            </button>
            <button class="verso-toolbar-btn" @onclick="OnOpenClick" data-verso-tip="@UI.Toolbar_OpenFile">
                <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4v9a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1H8L6.5 3.5 6 3H3a1 1 0 0 0-1 1z"/></svg>
                @UI.Toolbar_Open
            </button>
        </div>

        @if (_showOpenInput)
        {
            <div class="verso-toolbar-group">
                <input class="verso-toolbar-input" @bind="_openFilePath" @bind:event="oninput" placeholder="@UI.Toolbar_OpenPathPlaceholder" @onkeydown="OnOpenKeyDown" />
                <button class="verso-toolbar-btn" @onclick="OnOpenFile">@UI.Toolbar_Go</button>
                <label class="verso-toolbar-btn verso-toolbar-btn--browse">
                    @UI.Toolbar_Browse
                    <InputFile accept=".verso,.ipynb" OnChange="OnFileSelected" style="display:none" />
                </label>
                <button class="verso-toolbar-btn" @onclick="() => _showOpenInput = false">@UI.Common_Cancel</button>
            </div>
        }
    }

    @if (Service.IsLoaded)
    {
        @if (!Service.IsEmbedded)
        {
            <div class="verso-toolbar-separator"></div>
        }

        <button class="verso-toolbar-btn"
                @onclick="OnSave"
                data-verso-tip="@UI.Toolbar_Save"
                data-verso-tip-desc="@(Service.IsDirty ? UI.Toolbar_SaveUnsavedChanges : null)">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2h8l2 2v9a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z"/><path d="M5 2v3h4V2"/><path d="M5 10h6v4H5z"/></svg>
            @UI.Toolbar_Save
            @if (Service.IsDirty)
            {
                <span class="verso-toolbar-dirty-dot" aria-hidden="true"></span>
            }
        </button>

        <div class="verso-toolbar-separator"></div>

        @foreach (var action in _filteredToolbarActions)
        {
            var a = action;
            @if (a.IsPrimary && IsExecutionInFlight)
            {
                @* While the kernel is running, the primary call to action flips from "run"
                   to "stop": clicking it cancels the in-flight execution instead of starting
                   another. The swap keys off IsPrimary rather than a specific action id so
                   any host- or extension-supplied primary action gets the same treatment. *@
                <button class="verso-toolbar-btn verso-toolbar-btn--stop"
                        data-verso-tip="@UI.Toolbar_StopExecution"
                        aria-label="@UI.Toolbar_StopExecution"
                        @onclick="CancelExecutionAsync">
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><rect x="3.5" y="3.5" width="9" height="9" rx="1"/></svg>
                    @UI.Common_Stop
                </button>
            }
            else
            {
                var isEnabled = _enabledStates.GetValueOrDefault(a.ActionId, false);
                var iconOnly = a.IconOnly && a.Icon is not null;
                <button class="verso-toolbar-btn @(iconOnly ? "verso-toolbar-btn--icon" : "") @(a.IsPrimary ? "verso-toolbar-btn--primary" : "")"
                        disabled="@(!isEnabled)"
                        data-verso-tip="@a.DisplayName"
                        data-verso-tip-desc="@a.Description"
                        aria-label="@a.DisplayName"
                        @onclick="() => OnActionClicked(a)">
                    @if (a.Icon is not null)
                    {
                        @((MarkupString)a.Icon)
                    }
                    @if (!iconOnly)
                    {
                        @a.DisplayName
                    }
                </button>
            }
        }

        <div class="verso-toolbar-separator"></div>

        @* Only surface export actions that are currently enabled. Actions gate themselves through
           IsEnabledAsync (a layout-specific export enables only while its layout is active), so a
           disabled action is hidden outright rather than shown greyed-out, and the Export button
           disappears when nothing is exportable. The enabled set is recomputed in
           RefreshEnabledStatesAsync. *@
        @if (_enabledExportActions.Count > 0)
        {
            <div class="verso-toolbar-dropdown">
                <button class="verso-toolbar-btn"
                        data-verso-tip="@UI.Toolbar_ExportNotebook"
                        @ref="_exportBtnRef"
                        aria-haspopup="true"
                        aria-expanded="@(_showExportDropdown ? "true" : "false")"
                        aria-controls="@ExportPopupId"
                        @onclick="ToggleExportDropdown"
                        @onclick:stopPropagation="true">
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M14 10v3a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-3"/><polyline points="5.5 5 8 2.5 10.5 5"/><line x1="8" y1="2.5" x2="8" y2="10"/></svg>
                    @UI.Toolbar_Export &#9662;
                </button>
                @if (_showExportDropdown)
                {
                    @* popover="manual" lifts the menu into the browser top layer. The toolbar
                       clips its own overflow, and scrolls horizontally in a narrow pane, so a menu
                       drawn inside it is cut off at the toolbar's height. Positioned at the button
                       by versoCellMenu from OnAfterRenderAsync. *@
                    <div class="verso-toolbar-dropdown-popup"
                         id="@ExportPopupId"
                         popover="manual"
                         @ref="_exportPopupRef"
                         @onclick:stopPropagation="true">
                        @foreach (var action in _enabledExportActions)
                        {
                            var a = action;
                            <button class="verso-toolbar-btn"
                                    @onclick="() => ExecuteExportAsync(a)">
                                @a.DisplayName
                            </button>
                        }
                    </div>
                }
            </div>
        }

        @* Panel toggles.

           These were a rail of rotated labels pinned to the right edge of the notebook,
           which cost 32px of width permanently and asked the reader to tilt their head.
           As toggles they cost nothing while closed. Icon-only at rest and labelled only
           while active, because five labelled pills will not fit beside the actions in a
           narrow editor pane and the panel that is open is the only one worth naming. *@
        @if (OnTogglePanel.HasDelegate)
        {
            <span class="verso-toolbar-spacer"></span>

            @* One control per panel, host panels and extension panels alike. Each is
               icon-only at rest and gains its label when active, which is what keeps
               five or more of them from crowding the toolbar. *@
            <div class="verso-toolbar-group verso-toolbar-group--panels">
                @foreach (var panel in Panels)
                {
                    var p = panel;
                    var isActive = ActivePanel == p.Key;
                    var icon = PanelIcons.Resolve(p.IconName, p.IconMarkup);
                    <button class="verso-toolbar-toggle @(isActive ? "verso-toolbar-toggle--active" : "")"
                            @key="p.Key"
                            @onclick="() => OnTogglePanel.InvokeAsync(p.Key)"
                            aria-pressed="@(isActive ? "true" : "false")" aria-label="@p.DisplayName"
                            data-verso-tip="@p.DisplayName" data-verso-tip-desc="@p.Description">
                        @if (icon is not null)
                        {
                            @((MarkupString)icon)
                        }
                        else
                        {
                            <span class="verso-toolbar-toggle-initial" aria-hidden="true">@PanelIcons.InitialFor(p.DisplayName)</span>
                        }
                        @if (isActive)
                        {
                            <span>@p.DisplayName</span>
                        }
                    </button>
                }
            </div>
        }
    }
</div>

@if (_pendingConfirmAction is { } pending)
{
    <div class="verso-modal-overlay" @onclick="CancelPendingAction">
        <div class="verso-modal" role="dialog" aria-modal="true" aria-label="@pending.DisplayName"
             @onclick:stopPropagation="true" @onkeydown="HandleConfirmKeyDown">
            <div class="verso-modal-header">
                <span class="verso-modal-title">@pending.DisplayName</span>
                <button class="verso-modal-close" @onclick="CancelPendingAction" aria-label="@UI.Common_Cancel" data-verso-tip="@UI.Common_Cancel">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="4" y1="4" x2="12" y2="12"/><line x1="12" y1="4" x2="4" y2="12"/></svg>
                </button>
            </div>
            <div class="verso-modal-body">
                <p style="margin:0;">@pending.ConfirmationPrompt</p>
            </div>
            <div class="verso-modal-footer">
                <button class="verso-modal-btn verso-modal-btn--secondary"
                        @onclick="CancelPendingAction">@UI.Common_Cancel</button>
                <button class="verso-modal-btn verso-modal-btn--primary"
                        @onclick="ConfirmPendingActionAsync">@pending.DisplayName</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public INotebookService Service { get; set; } = default!;
    [Parameter] public Guid? SelectedCellId { get; set; }

    /// <summary>
    /// Key of the side panel currently open, or <c>null</c> when none is. The panel toggles
    /// are only rendered when <see cref="OnTogglePanel"/> is bound, so a host that does not
    /// own a panel set gets a toolbar without them.
    /// </summary>
    [Parameter] public string? ActivePanel { get; set; }

    /// <summary>Raised with the panel key when a toggle is pressed. Toggling the open panel closes it.</summary>
    [Parameter] public EventCallback<string> OnTogglePanel { get; set; }

    /// <summary>
    /// The panels to offer, already ordered and filtered to those currently available.
    /// The hosting page owns this list because it also renders the panel body.
    /// </summary>
    [Parameter] public IReadOnlyList<NotebookPanelInfo> Panels { get; set; } = Array.Empty<NotebookPanelInfo>();

    /// <summary>
    /// Set by the hosting page while it has an execution in flight (Run All or a cell run it
    /// started). The per-cell execution events momentarily report zero running cells between
    /// the cells of a batch, so without this flag the Stop button and the status pill would
    /// toggle back to their idle forms at every cell boundary. While this is <c>true</c> the
    /// toolbar holds the running presentation until the whole run finishes.
    /// </summary>
    [Parameter] public bool IsExecuting { get; set; }
    [Parameter] public EventCallback OnNewNotebook { get; set; }
    [Parameter] public EventCallback<string> OnOpenNotebook { get; set; }
    [Parameter] public EventCallback<(string FileName, string Content)> OnBrowseNotebook { get; set; }
    [Parameter] public EventCallback OnSaveNotebook { get; set; }
    [Parameter] public EventCallback<string> OnAddCell { get; set; }
    [Parameter] public EventCallback<string> OnActionExecuted { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }

    /// <summary>
    /// Optional interceptor invoked before the default <c>Service.ExecuteActionAsync</c> path.
    /// Return <c>true</c> to indicate the action was handled by the parent (the toolbar will
    /// skip its own execution and still fire <see cref="OnActionExecuted"/>).
    /// </summary>
    [Parameter] public Func<string, Task<bool>>? OnInterceptAction { get; set; }

    private List<ToolbarActionInfo> _filteredToolbarActions = new();
    private IReadOnlyList<ToolbarActionInfo> _exportActions = Array.Empty<ToolbarActionInfo>();
    private Dictionary<string, bool> _enabledStates = new();
    private Dictionary<string, bool> _exportEnabledStates = new();
    private IReadOnlyList<ToolbarActionInfo> _enabledExportActions = Array.Empty<ToolbarActionInfo>();
    private bool _showOpenInput;
    private string _openFilePath = "";
    private bool _showExportDropdown;

    // Top-layer menu plumbing: the refs the positioning helper needs, plus the flag
    // tracking what the DOM currently reflects so the popover is shown or torn down
    // only on an actual transition.
    private ElementReference _exportBtnRef;
    private ElementReference _exportPopupRef;
    private bool _exportPopupShown;
    private readonly string ExportPopupId = $"verso-export-menu-{Guid.NewGuid():N}";

    // Layout and theme switching is the View panel's job, so the actions that duplicate it
    // are kept out of the action row.
    private static readonly HashSet<string> _excludedActionIds = new(StringComparer.OrdinalIgnoreCase)
    {
        "verso.switchLayout",
        "verso.switchTheme"
    };

    // --- Document info cluster ---

    // Hard cap on the displayed document name; longer names are cut with an ellipsis (the full
    // name stays available via the name span's tooltip). Keeps the cluster a predictable width
    // rather than letting it grow with the file name.
    private const int DocNameMaxLength = 20;

    private string DocNameFull
    {
        get
        {
            var name = !string.IsNullOrEmpty(Service.FilePath)
                ? System.IO.Path.GetFileName(Service.FilePath)
                : Service.Title;
            return string.IsNullOrWhiteSpace(name) ? UI.Common_Untitled : name!;
        }
    }

    private string DocName
    {
        get
        {
            var name = DocNameFull;
            return name.Length > DocNameMaxLength ? name[..DocNameMaxLength] + "…" : name;
        }
    }

    // The cluster already shows the file name and the notebook's kernel, so it earns
    // a tooltip only when it is holding something back: a name the label truncated,
    // or the other kernels a polyglot notebook is using. Null on both counts means
    // no tooltip at all rather than one that reads back what is already there.
    private bool IsPolyglot => DistinctLanguageIds.Count > 1;

    private string? DocInfoTip =>
        DocNameFull.Length > DocNameMaxLength || IsPolyglot ? DocNameFull : null;

    private string? DocInfoTipDetail => IsPolyglot ? KernelTooltip : null;

    private int CellCount => Service.Cells.Count;

    private string CellCountLabel => string.Format(
        Plural.Of(CellCount, UI.Toolbar_CellCount_One, UI.Toolbar_CellCount_Other), CellCount);

    private string PrimaryKernelName =>
        ResolveLanguageName(Service.DefaultKernelId) ?? UI.Toolbar_NoKernel;

    // Distinct languages actually in use across code cells (a cell with no
    // explicit language inherits the notebook default).
    private List<string> DistinctLanguageIds => Service.Cells
        .Where(c => string.Equals(c.Type, "code", StringComparison.OrdinalIgnoreCase))
        .Select(c => c.Language ?? Service.DefaultKernelId)
        .Where(id => !string.IsNullOrEmpty(id))
        .Select(id => id!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    // The kernel label in the meta line. When more than one language is in use
    // the primary kernel name is suffixed with the count of the others.
    private string KernelLabel
    {
        get
        {
            var others = DistinctLanguageIds.Count - 1;
            return others > 0 ? $"{PrimaryKernelName} +{others}" : PrimaryKernelName;
        }
    }

    // Tooltip enumerating every kernel in use when the notebook is polyglot.
    private string KernelTooltip
    {
        get
        {
            var names = DistinctLanguageIds
                .Select(id => ResolveLanguageName(id) ?? id)
                .ToList();
            return names.Count > 1 ? string.Format(UI.Toolbar_KernelList, string.Join(", ", names)) : PrimaryKernelName;
        }
    }

    private string? ResolveLanguageName(string? languageId)
    {
        if (string.IsNullOrEmpty(languageId)) return null;
        return Service.RegisteredLanguages
            .FirstOrDefault(l => string.Equals(l.Id, languageId, StringComparison.OrdinalIgnoreCase))?.DisplayName
            ?? languageId;
    }

    // --- Kernel status ---
    // Derived from the execution/restart/health events. The set of in-flight
    // cells tracks concurrent runs so the pill only returns to idle once every
    // cell has finished.

    private enum KernelActivity { Idle, Running, Restarting, Error, Disconnected }

    private KernelActivity _kernelActivity = KernelActivity.Idle;
    private string? _kernelStatusDetail;
    private readonly HashSet<Guid> _runningCells = new();
    private bool _kernelEventsWired;

    // The page-level IsExecuting flag holds the running presentation across the idle gaps
    // between cells of a batch; the per-cell events cover runs the page did not start
    // (e.g. an extension action executing cells). Restart/error states always win.
    private KernelActivity EffectiveActivity =>
        _kernelActivity == KernelActivity.Idle && IsExecuting
            ? KernelActivity.Running
            : _kernelActivity;

    // The primary action swaps to Stop whenever an execution is in flight, regardless of
    // whether the run started from the toolbar or a cell's own Run button; cancelling
    // targets the current execution either way.
    private bool IsExecutionInFlight => EffectiveActivity == KernelActivity.Running;

    private string KernelStatusText => EffectiveActivity switch
    {
        KernelActivity.Running => UI.Toolbar_KernelRunning,
        KernelActivity.Restarting => UI.Toolbar_KernelRestarting,
        KernelActivity.Error => UI.Toolbar_KernelError,
        KernelActivity.Disconnected => UI.Toolbar_KernelDisconnected,
        _ => UI.Toolbar_KernelIdle
    };

    // Error and disconnected states carry the underlying cause (exception message,
    // process exit detail), shown beneath the status in the tooltip. Null when there
    // is nothing to add, which leaves the tooltip as the status alone.
    private string? KernelStatusDetail =>
        string.IsNullOrWhiteSpace(_kernelStatusDetail) ? null : _kernelStatusDetail;

    private string KernelStatusClass => EffectiveActivity switch
    {
        KernelActivity.Running => "verso-kernel-status--running",
        KernelActivity.Restarting => "verso-kernel-status--restarting",
        KernelActivity.Error => "verso-kernel-status--error",
        KernelActivity.Disconnected => "verso-kernel-status--error",
        _ => "verso-kernel-status--idle"
    };

    private void WireServiceEvents()
    {
        if (_kernelEventsWired || Service is null) return;
        Service.OnCellExecuting += HandleCellExecuting;
        Service.OnCellExecutionCompleted += HandleCellExecutionCompleted;
        Service.OnKernelRestarting += HandleKernelRestarting;
        Service.OnKernelRestarted += HandleKernelRestarted;
        Service.OnKernelHealthChanged += HandleKernelHealthChanged;
        Service.OnDirtyStateChanged += HandleDirtyStateChanged;
        _kernelEventsWired = true;
    }

    private void HandleCellExecuting(Guid cellId)
    {
        // These events fire on the kernel's execution/restart thread. Marshal the state
        // mutation and the render onto Blazor's dispatcher together so the shared
        // _runningCells set and status fields are never written off the dispatcher (a
        // concurrent read from CancelExecutionAsync would otherwise race the HashSet).
        _ = InvokeAsync(() =>
        {
            _runningCells.Add(cellId);
            _kernelActivity = KernelActivity.Running;
            _kernelStatusDetail = null;
            StateHasChanged();
        });
    }

    private void HandleCellExecutionCompleted(Guid cellId)
    {
        _ = InvokeAsync(() =>
        {
            _runningCells.Remove(cellId);
            // Only fall back to idle from Running; a restart, error, or disconnect
            // reported mid-run must not be cleared by a straggling completion event.
            if (_runningCells.Count == 0 && _kernelActivity == KernelActivity.Running)
                _kernelActivity = KernelActivity.Idle;
            StateHasChanged();
        });
    }

    private void HandleKernelRestarting(string? kernelId)
    {
        _ = InvokeAsync(() =>
        {
            _kernelActivity = KernelActivity.Restarting;
            _kernelStatusDetail = null;
            StateHasChanged();
        });
    }

    private void HandleKernelRestarted(string? kernelId)
    {
        _ = InvokeAsync(() =>
        {
            _runningCells.Clear();
            _kernelActivity = KernelActivity.Idle;
            _kernelStatusDetail = null;
            StateHasChanged();
        });
    }

    private void HandleKernelHealthChanged(KernelHealthChangedEventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            switch (args.Health)
            {
                case KernelHealth.Disconnected:
                    _runningCells.Clear();
                    _kernelActivity = KernelActivity.Disconnected;
                    _kernelStatusDetail = args.Detail;
                    break;
                case KernelHealth.Faulted:
                    _runningCells.Clear();
                    _kernelActivity = KernelActivity.Error;
                    _kernelStatusDetail = args.Detail;
                    break;
                default:
                    if (_kernelActivity is KernelActivity.Error or KernelActivity.Disconnected)
                        _kernelActivity = _runningCells.Count > 0 ? KernelActivity.Running : KernelActivity.Idle;
                    _kernelStatusDetail = null;
                    break;
            }
            StateHasChanged();
        });
    }

    private void HandleDirtyStateChanged()
        => _ = InvokeAsync(StateHasChanged);

    private async Task CancelExecutionAsync()
    {
        // Both hosts cancel whatever execution is currently in flight; the cell id is
        // informational (see INotebookService.CancelCellAsync).
        try
        {
            await Service.CancelCellAsync(_runningCells.FirstOrDefault());
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(string.Format(UI.Toolbar_StopFailed, ex.Message));
        }
    }

    public void Dispose()
    {
        if (!_kernelEventsWired || Service is null) return;
        Service.OnCellExecuting -= HandleCellExecuting;
        Service.OnCellExecutionCompleted -= HandleCellExecutionCompleted;
        Service.OnKernelRestarting -= HandleKernelRestarting;
        Service.OnKernelRestarted -= HandleKernelRestarted;
        Service.OnKernelHealthChanged -= HandleKernelHealthChanged;
        Service.OnDirtyStateChanged -= HandleDirtyStateChanged;
    }

    protected override void OnInitialized()
    {
        WireServiceEvents();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Service.IsLoaded)
        {
            _filteredToolbarActions = Service.GetToolbarActions(ToolbarPlacement.MainToolbar)
                .Where(a => !_excludedActionIds.Contains(a.ActionId))
                .ToList();

            _exportActions = Service.GetToolbarActions(ToolbarPlacement.ExportMenu);

            await RefreshEnabledStatesAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await ReconcileExportPopoverAsync();
    }

    // Shows or tears down the export menu's popover to match component state. On open the
    // menu has just been rendered, so it is lifted into the top layer and placed at the
    // button; on close it has already left the DOM, which closes the popover, leaving only
    // its position tracker to remove. Guarded so a browser without the Popover API just
    // leaves the menu on its own CSS layer rather than throwing.
    private async Task ReconcileExportPopoverAsync()
    {
        if (_showExportDropdown == _exportPopupShown) return;

        try
        {
            if (_showExportDropdown)
                await JS.InvokeVoidAsync("versoCellMenu.open", _exportPopupRef, _exportBtnRef, ExportPopupId);
            else
                await JS.InvokeVoidAsync("versoCellMenu.close", ExportPopupId);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }

        _exportPopupShown = _showExportDropdown;
    }

    private async Task RefreshEnabledStatesAsync()
    {
        var selectedIds = SelectedCellId.HasValue
            ? new List<Guid> { SelectedCellId.Value }
            : new List<Guid>();

        _enabledStates = await Service.GetActionEnabledStatesAsync(
            ToolbarPlacement.MainToolbar, selectedIds);

        if (_exportActions.Count > 0)
        {
            _exportEnabledStates = await Service.GetActionEnabledStatesAsync(
                ToolbarPlacement.ExportMenu, selectedIds);
        }

        _enabledExportActions = _exportActions
            .Where(a => _exportEnabledStates.GetValueOrDefault(a.ActionId, false))
            .ToList();
    }

    // --- Action confirmation ---

    private ToolbarActionInfo? _pendingConfirmAction;

    // Actions that declare a ConfirmationPrompt (e.g. Restart Kernel, whose effect cannot
    // be undone) go through a confirm dialog; everything else executes immediately.
    private Task OnActionClicked(ToolbarActionInfo action)
    {
        if (!string.IsNullOrWhiteSpace(action.ConfirmationPrompt))
        {
            _pendingConfirmAction = action;
            return Task.CompletedTask;
        }
        return ExecuteActionAsync(action);
    }

    private async Task ConfirmPendingActionAsync()
    {
        var action = _pendingConfirmAction;
        _pendingConfirmAction = null;
        if (action is not null)
            await ExecuteActionAsync(action);
    }

    private void CancelPendingAction() => _pendingConfirmAction = null;

    private async Task HandleConfirmKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmPendingActionAsync();
        else if (e.Key == "Escape") CancelPendingAction();
    }

    private async Task ExecuteActionAsync(ToolbarActionInfo action)
    {
        try
        {
            // Let the parent handle the action when an interceptor is provided
            if (OnInterceptAction is not null && await OnInterceptAction(action.ActionId))
            {
                await OnActionExecuted.InvokeAsync(action.ActionId);
                return;
            }

            var selectedIds = SelectedCellId.HasValue
                ? new List<Guid> { SelectedCellId.Value }
                : new List<Guid>();

            await Service.ExecuteActionAsync(action.ActionId, selectedIds);
            await OnActionExecuted.InvokeAsync(action.ActionId);
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(string.Format(UI.Toolbar_ActionFailed, action.DisplayName, ex.Message));
        }
    }

    private async Task OnNew() => await OnNewNotebook.InvokeAsync();
    private void OnOpenClick() => _showOpenInput = !_showOpenInput;

    private async Task OnOpenKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await OnOpenFile();
    }

    private async Task OnOpenFile()
    {
        if (!string.IsNullOrWhiteSpace(_openFilePath))
        {
            await OnOpenNotebook.InvokeAsync(_openFilePath.Trim());
            _showOpenInput = false;
            _openFilePath = "";
        }
    }

    private void ToggleExportDropdown()
    {
        _showExportDropdown = !_showExportDropdown;
    }

    private async Task ExecuteExportAsync(ToolbarActionInfo action)
    {
        _showExportDropdown = false;
        await ExecuteActionAsync(action);
    }

    private void CloseAllDropdowns()
    {
        _showExportDropdown = false;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024); // 50 MB
            using var reader = new System.IO.StreamReader(stream);
            var content = await reader.ReadToEndAsync();
            await OnBrowseNotebook.InvokeAsync((file.Name, content));
            _showOpenInput = false;
            _openFilePath = "";
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(string.Format(UI.Toolbar_ReadFileFailed, ex.Message));
        }
    }

    private async Task OnSave() => await OnSaveNotebook.InvokeAsync();
    private async Task OnAddCodeCell() => await OnAddCell.InvokeAsync("code");
}
