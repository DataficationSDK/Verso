@using Verso.Abstractions

@if (IsVisible)
{
    <div class="verso-modal-overlay" @onclick="HandleDeny">
        <div class="verso-modal" @onclick:stopPropagation="true" @onkeydown="HandleKeyDown">
            <div class="verso-modal-header">
                <span class="verso-modal-title">@Title</span>
                <button class="verso-modal-close" @onclick="HandleDeny" aria-label="@UI.Consent_Deny" data-verso-tip="@UI.Consent_Deny">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="4" y1="4" x2="12" y2="12"/><line x1="12" y1="4" x2="4" y2="12"/></svg>
                </button>
            </div>
            <div class="verso-modal-body">
                <p style="margin:0 0 8px 0;">@Introduction</p>
                <ul style="margin:0 0 12px 0; padding-left:20px;">
                    @foreach (var ext in Extensions)
                    {
                        <li>
                            <strong>@ext.PackageId</strong>@(ext.Version is not null ? $" ({ext.Version})" : "")
                            @if (ext.Source != "cell")
                            {
                                <span style="opacity:0.7;"> (@ext.Source)</span>
                            }
                        </li>
                    }
                </ul>
                @if (Target is not null)
                {
                    <p style="margin:0 0 12px 0; opacity:0.8;">@(string.Format(UI.Consent_Target, Target))</p>
                }
                <div class="verso-modal-hint" style="color:var(--verso-status-warning, #b58900);">
                    @Warning
                </div>
            </div>
            <div class="verso-modal-footer">
                <button class="verso-modal-btn verso-modal-btn--secondary"
                        @onclick="HandleDeny">@UI.Consent_Deny</button>
                <button class="verso-modal-btn verso-modal-btn--primary"
                        @onclick="HandleApprove">@ApproveLabel</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public IReadOnlyList<ExtensionConsentInfo> Extensions { get; set; } = Array.Empty<ExtensionConsentInfo>();
    [Parameter] public EventCallback<bool> OnConsentResult { get; set; }

    /// <summary>
    /// One request covers one kind of thing, so the wording is taken from the first entry rather
    /// than mixed per item.
    /// </summary>
    private ConsentKind Kind => Extensions.Count > 0 ? Extensions[0].Kind : ConsentKind.Extension;

    private bool IsPackage => Kind == ConsentKind.Package;

    private string Title => IsPackage ? UI.Consent_TitlePackage : UI.Consent_TitleExtension;

    private string Introduction => IsPackage
        ? Plural.Of(Extensions.Count, UI.Consent_IntroPackage_One, UI.Consent_IntroPackage_Other)
        : Plural.Of(Extensions.Count, UI.Consent_IntroExtension_One, UI.Consent_IntroExtension_Other);

    private string Warning => IsPackage
        ? UI.Consent_WarningPackage
        : UI.Consent_WarningExtension;

    private string ApproveLabel => IsPackage ? UI.Consent_ApproveInstall : UI.Consent_ApproveAll;

    /// <summary>Where the packages go, shown once for the request.</summary>
    private string? Target => Extensions
        .Select(e => e.Target)
        .FirstOrDefault(t => !string.IsNullOrWhiteSpace(t));

    private async Task HandleApprove() => await OnConsentResult.InvokeAsync(true);
    private async Task HandleDeny() => await OnConsentResult.InvokeAsync(false);

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleApprove();
        else if (e.Key == "Escape") await HandleDeny();
    }
}
