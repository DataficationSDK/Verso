@inject IJSRuntime JS

<div id="@_overlayId" class="verso-diff-overlay" tabindex="-1"
     @onkeydown="HandleKeyDown" @onkeydown:stopPropagation="true">
    <div class="verso-diff-panel">
        <div class="verso-diff-header">
            <div class="verso-diff-title">
                <span class="verso-diff-title-text">@string.Format(UI.DiffView_ComparingWith, Diff.BaselineLabel)</span>
                <div class="verso-diff-summary">
                    @* The sign travels with the count rather than sitting in the resource, so a
                       language that puts the number elsewhere in the phrase keeps them together. *@
                    @if (Diff.Summary.Added > 0)
                    {
                        <span class="verso-diff-summary-badge verso-diff-summary-badge--added">@string.Format(UI.Compare_SummaryAdded, $"+{Diff.Summary.Added}")</span>
                    }
                    @if (Diff.Summary.Removed > 0)
                    {
                        <span class="verso-diff-summary-badge verso-diff-summary-badge--removed">@string.Format(UI.Compare_SummaryRemoved, $"−{Diff.Summary.Removed}")</span>
                    }
                    @if (Diff.Summary.Modified > 0)
                    {
                        <span class="verso-diff-summary-badge verso-diff-summary-badge--modified">@string.Format(UI.Compare_SummaryModified, Diff.Summary.Modified)</span>
                    }
                    @if (Diff.Summary.Moved > 0)
                    {
                        <span class="verso-diff-summary-badge verso-diff-summary-badge--moved">@string.Format(UI.Compare_SummaryMoved, Diff.Summary.Moved)</span>
                    }
                    @if (!HasChanges)
                    {
                        <span class="verso-diff-summary-badge">@UI.DiffView_NoChanges</span>
                    }
                </div>
            </div>

            @* Stepping between changes, because the summary says how many there are and
               the reader should not have to hunt for them in a long notebook. *@
            @if (ChangedIndexes.Count > 1)
            {
                <div class="verso-diff-nav">
                    <span class="verso-diff-nav-position">@NavPositionLabel</span>
                    <button class="verso-diff-nav-btn" aria-label="@UI.DiffView_PreviousChange"
                            data-verso-tip="@UI.DiffView_PreviousChange" data-verso-tip-desc="@UI.Key_AltUp"
                            @onclick="() => StepAsync(-1)">
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 10 8 6 12 10"/></svg>
                    </button>
                    <button class="verso-diff-nav-btn" aria-label="@UI.DiffView_NextChange"
                            data-verso-tip="@UI.DiffView_NextChange" data-verso-tip-desc="@UI.Key_AltDown"
                            @onclick="() => StepAsync(1)">
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 6 8 10 12 6"/></svg>
                    </button>
                </div>
            }

            <button class="verso-diff-close" aria-label="@UI.Common_Close"
                    data-verso-tip="@UI.Common_Close" data-verso-tip-desc="@UI.Key_Escape" @onclick="() => OnClose.InvokeAsync()">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="4" y1="4" x2="12" y2="12"/><line x1="12" y1="4" x2="4" y2="12"/></svg>
            </button>
        </div>

        <div class="verso-diff-body">
            @if (!HasChanges)
            {
                <div class="verso-diff-empty">
                    <svg viewBox="0 0 16 16" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6.4"/><path d="M5.2 8.2 7.2 10.2 10.9 6.1"/></svg>
                    <p class="verso-diff-empty-title">@string.Format(UI.DiffView_IdenticalTo, Diff.BaselineLabel)</p>
                    <p class="verso-diff-empty-detail">@UI.DiffView_IdenticalDetail</p>
                </div>
            }

            @if (Diff.MetadataChanges.Count > 0)
            {
                <div class="verso-diff-metadata">
                    <div class="verso-diff-metadata-title">@UI.Compare_NotebookSettings</div>
                    @foreach (var change in Diff.MetadataChanges)
                    {
                        <div class="verso-diff-metadata-row">
                            <span class="verso-diff-metadata-field">@change.Field</span>
                            <span class="verso-diff-metadata-value verso-diff-metadata-value--baseline">@(change.BaselineValue ?? UI.Compare_NotSet)</span>
                            <span class="verso-diff-metadata-arrow">&#8594;</span>
                            <span class="verso-diff-metadata-value verso-diff-metadata-value--current">@(change.CurrentValue ?? UI.Compare_NotSet)</span>
                        </div>
                    }
                </div>
            }

            @foreach (var block in BuildBlocks())
            {
                @if (block.UnchangedRun is not null)
                {
                    var run = block.UnchangedRun;
                    <div class="verso-diff-unchanged-group">
                        <button class="verso-diff-unchanged-toggle" @onclick="() => ToggleGroup(run.StartIndex)">
                            <span class="verso-diff-chevron @(IsGroupExpanded(run.StartIndex) ? "verso-diff-chevron--open" : "")">@Chevron</span>
                            @string.Format(Plural.Of(run.Entries.Count, UI.DiffView_UnchangedCells_One, UI.DiffView_UnchangedCells_Other), run.Entries.Count)
                        </button>
                        @if (IsGroupExpanded(run.StartIndex))
                        {
                            @foreach (var entry in run.Entries)
                            {
                                <div class="verso-diff-cell verso-diff-cell--unchanged">
                                    <div class="verso-diff-cell-header">
                                        @CellBadges(entry)
                                    </div>
                                    <pre class="verso-diff-source-block">@entry.CurrentCell!.Source</pre>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    var entry = block.Entry!;
                    var entryIndex = block.EntryIndex;
                    @switch (entry.Kind)
                    {
                        case CellDiffKind.Added:
                            <div class="verso-diff-cell verso-diff-cell--added" id="@AnchorId(entryIndex)">
                                <div class="verso-diff-cell-header">
                                    <span class="verso-diff-kind-badge verso-diff-kind-badge--added">@UI.Diff_Added</span>
                                    @CellBadges(entry)
                                </div>
                                <pre class="verso-diff-source-block verso-diff-source-block--added">@entry.CurrentCell!.Source</pre>
                            </div>
                            break;

                        case CellDiffKind.Removed:
                            <div class="verso-diff-cell verso-diff-cell--removed" id="@AnchorId(entryIndex)">
                                <div class="verso-diff-cell-header">
                                    <span class="verso-diff-kind-badge verso-diff-kind-badge--removed">@UI.Diff_Removed</span>
                                    @CellBadges(entry)
                                </div>
                                <pre class="verso-diff-source-block verso-diff-source-block--removed">@entry.BaselineCell!.Source</pre>
                            </div>
                            break;

                        case CellDiffKind.Moved:
                            <div class="verso-diff-cell verso-diff-cell--moved" id="@AnchorId(entryIndex)">
                                <div class="verso-diff-cell-header">
                                    <span class="verso-diff-kind-badge verso-diff-kind-badge--moved">@UI.Diff_Moved</span>
                                    @CellBadges(entry)
                                    <span class="verso-diff-move-detail">@string.Format(UI.DiffView_PositionChange, entry.BaselineIndex + 1, entry.CurrentIndex + 1)</span>
                                </div>
                            </div>
                            break;

                        case CellDiffKind.Modified:
                            <div class="verso-diff-cell verso-diff-cell--modified" id="@AnchorId(entryIndex)">
                                <div class="verso-diff-cell-header">
                                    <span class="verso-diff-kind-badge verso-diff-kind-badge--modified">@UI.Diff_Modified</span>
                                    @CellBadges(entry)
                                    @ChangeFlagChips(entry)
                                </div>
                                @if (entry.SourceChanged)
                                {
                                    @if (IsDiffExpanded(entryIndex))
                                    {
                                        <MonacoDiffEditor OriginalValue="@entry.BaselineCell!.Source"
                                                          ModifiedValue="@entry.CurrentCell!.Source"
                                                          Language="@LanguageFor(entry.CurrentCell)" />
                                    }
                                    else
                                    {
                                        <button class="verso-diff-expand-btn" @onclick="() => ExpandDiff(entryIndex)">
                                            @UI.DiffView_ShowSourceChanges
                                        </button>
                                    }
                                }
                                @if (entry.OutputsChanged)
                                {
                                    <div class="verso-diff-outputs">
                                        <button class="verso-diff-outputs-toggle" @onclick="() => ToggleOutputs(entryIndex)">
                                            <span class="verso-diff-chevron @(AreOutputsExpanded(entryIndex) ? "verso-diff-chevron--open" : "")">@Chevron</span>
                                            @UI.DiffView_OutputsChanged
                                        </button>
                                        @if (AreOutputsExpanded(entryIndex))
                                        {
                                            <div class="verso-diff-outputs-columns">
                                                <div class="verso-diff-outputs-column">
                                                    <div class="verso-diff-outputs-column-title">@Diff.BaselineLabel</div>
                                                    <OutputView Outputs="entry.BaselineCell!.Outputs" />
                                                </div>
                                                <div class="verso-diff-outputs-column">
                                                    <div class="verso-diff-outputs-column-title">@UI.DiffView_Current</div>
                                                    <OutputView Outputs="entry.CurrentCell!.Outputs" />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            break;
                    }
                }
            }
        </div>
    </div>
</div>

@code {
    /// <summary>The computed diff to display.</summary>
    [Parameter] public NotebookDiffResult Diff { get; set; } = default!;

    /// <summary>Invoked when the user closes the view (close button or Escape).</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// When more than this many cells are modified, source diffs start collapsed and mount
    /// their Monaco editors only when expanded, bounding concurrent editor instances on
    /// large notebooks.
    /// </summary>
    public const int MaxEagerDiffEditors = 25;

    private readonly string _overlayId = $"verso-diff-{Guid.NewGuid():N}";
    private readonly HashSet<int> _expandedGroups = new();
    private readonly HashSet<int> _expandedOutputs = new();
    private readonly HashSet<int> _expandedDiffs = new();
    private bool _eagerDiffEditors;
    private int _navPosition = -1;

    private bool HasChanges
        => Diff.Summary.Added + Diff.Summary.Removed + Diff.Summary.Modified + Diff.Summary.Moved > 0
            || Diff.MetadataChanges.Count > 0;

    /// <summary>Disclosure triangle, matching the one every other collapsible surface draws.</summary>
    private static readonly MarkupString Chevron = new(
        "<svg viewBox=\"0 0 16 16\" width=\"11\" height=\"11\" fill=\"none\" stroke=\"currentColor\" "
        + "stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 3.5 10.5 8 6 12.5\"/></svg>");

    // Indexes into Diff.Cells of everything that is not unchanged, in document order.
    // Both the anchors and the stepper key off this, so they cannot drift apart.
    private List<int> ChangedIndexes => Diff.Cells
        .Select((entry, index) => (entry, index))
        .Where(x => x.entry.Kind != CellDiffKind.Unchanged)
        .Select(x => x.index)
        .ToList();

    private string NavPositionLabel
    {
        get
        {
            var total = ChangedIndexes.Count;
            return _navPosition < 0
                ? string.Format(Plural.Of(total, UI.DiffView_ChangeCount_One, UI.DiffView_ChangeCount_Other), total)
                : string.Format(UI.DiffView_NavPosition, _navPosition + 1, total);
        }
    }

    private string AnchorId(int entryIndex) => $"{_overlayId}-change-{entryIndex}";

    protected override void OnParametersSet()
    {
        _eagerDiffEditors = Diff.Summary.Modified <= MaxEagerDiffEditors;
        _navPosition = -1;
    }

    /// <summary>
    /// Moves to the next or previous change and scrolls it to the top. Wraps at both ends,
    /// which is what makes repeated presses a way to sweep the whole diff.
    /// </summary>
    private async Task StepAsync(int direction)
    {
        var changes = ChangedIndexes;
        if (changes.Count == 0)
            return;

        _navPosition = _navPosition < 0
            ? (direction > 0 ? 0 : changes.Count - 1)
            : (_navPosition + direction + changes.Count) % changes.Count;

        try
        {
            await JS.InvokeVoidAsync("versoMonaco.scrollElementIntoView", AnchorId(changes[_navPosition]));
        }
        catch (JSException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("versoMonaco.focusElement", _overlayId); }
            catch (JSException) { }
        }
    }

    private bool IsGroupExpanded(int startIndex) => _expandedGroups.Contains(startIndex);

    private void ToggleGroup(int startIndex)
    {
        if (!_expandedGroups.Remove(startIndex))
        {
            _expandedGroups.Add(startIndex);
        }
    }

    private bool AreOutputsExpanded(int entryIndex) => _expandedOutputs.Contains(entryIndex);

    private void ToggleOutputs(int entryIndex)
    {
        if (!_expandedOutputs.Remove(entryIndex))
        {
            _expandedOutputs.Add(entryIndex);
        }
    }

    private bool IsDiffExpanded(int entryIndex) => _eagerDiffEditors || _expandedDiffs.Contains(entryIndex);

    private void ExpandDiff(int entryIndex) => _expandedDiffs.Add(entryIndex);

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
            return;
        }

        // Alt rather than a bare arrow, which has to keep scrolling the body, and rather
        // than F7, which the surrounding editor may already have claimed.
        if (e.AltKey && e.Key == "ArrowDown")
        {
            await StepAsync(1);
        }
        else if (e.AltKey && e.Key == "ArrowUp")
        {
            await StepAsync(-1);
        }
    }

    private static string LanguageFor(CellModel cell)
        => cell.Type == "markdown" ? "markdown" : (cell.Language ?? "csharp");

    private RenderFragment CellBadges(CellDiffEntry entry) => __builder =>
    {
        var cell = entry.CurrentCell ?? entry.BaselineCell;
        var position = entry.CurrentIndex ?? entry.BaselineIndex;
        <span class="verso-diff-cell-position">[@(position + 1)]</span>
        <span class="verso-diff-cell-type">@cell!.Type</span>
        @if (cell.Type == "code" && cell.Language is not null)
        {
            <span class="verso-diff-cell-lang">@cell.Language</span>
        }
        @if (entry.MatchedByContent && entry.Kind is CellDiffKind.Modified)
        {
            <span class="verso-diff-heuristic-hint"
                  data-verso-tip="@UI.DiffView_ApproximateMatch"
                  data-verso-tip-desc="@UI.DiffView_ApproximateMatchDesc">@UI.DiffView_ApproximateMatchChip</span>
        }
    };

    private RenderFragment ChangeFlagChips(CellDiffEntry entry) => __builder =>
    {
        @if (entry.TypeOrLanguageChanged)
        {
            <span class="verso-diff-flag-chip">@FormatTypeChange(entry)</span>
        }
        @if (entry.CellMetadataChanged)
        {
            <span class="verso-diff-flag-chip">@UI.DiffView_MetadataChip</span>
        }
    };

    private static string FormatTypeChange(CellDiffEntry entry)
    {
        var from = DescribeCellKind(entry.BaselineCell!);
        var to = DescribeCellKind(entry.CurrentCell!);
        return string.Format(UI.DiffView_TypeChange, from, to);
    }

    private static string DescribeCellKind(CellModel cell)
        => cell.Type == "code" && cell.Language is not null ? $"{cell.Type} ({cell.Language})" : cell.Type;

    private sealed class UnchangedRun
    {
        public int StartIndex { get; init; }
        public List<CellDiffEntry> Entries { get; } = new();
    }

    private sealed class DiffBlock
    {
        public UnchangedRun? UnchangedRun { get; init; }
        public CellDiffEntry? Entry { get; init; }
        public int EntryIndex { get; init; }
    }

    private IEnumerable<DiffBlock> BuildBlocks()
    {
        UnchangedRun? run = null;
        for (var i = 0; i < Diff.Cells.Count; i++)
        {
            var entry = Diff.Cells[i];
            if (entry.Kind == CellDiffKind.Unchanged)
            {
                run ??= new UnchangedRun { StartIndex = i };
                run.Entries.Add(entry);
                continue;
            }

            if (run is not null)
            {
                yield return new DiffBlock { UnchangedRun = run };
                run = null;
            }

            yield return new DiffBlock { Entry = entry, EntryIndex = i };
        }

        if (run is not null)
        {
            yield return new DiffBlock { UnchangedRun = run };
        }
    }
}
