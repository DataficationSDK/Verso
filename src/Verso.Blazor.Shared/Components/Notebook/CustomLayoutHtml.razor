@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using Verso.Abstractions
@using Verso.Blazor.Shared.Models
@using Verso.Blazor.Shared.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

@* The pool owns every cell as a live Blazor component. The portal-interop JS
   moves cell DOM nodes out of the pool into the [data-cell-slot] elements that
   live inside the layout root; pool wrappers stay hidden via inline display:none
   so cells without a matching slot do not appear in flow. The pool and root live
   in the same component so the @ref captures are stable in the same OnAfterRender. *@
<div class="verso-cell-pool" style="display: none" @ref="_poolRef">
    @if (Context is not null)
    {
        @foreach (var cell in Service.Cells)
        {
            <div @key="cell.Id" data-cell-id="@cell.Id">
                <Cell CellData="cell"
                      IsSelected="cell.Id == Context.SelectedCellId"
                      IsExecuting="cell.Id == Context.ExecutingCellId"
                      IsRunDisabled="Context.IsRunDisabled"
                      Index="0"
                      IsLast="false"
                      CollapsesInput="Service.ShouldCollapseInput(cell.Type)"
                      IsEditable="Service.IsCellTypeEditable(cell.Type)"
                      IsHeadingCell="false"
                      IsSectionCollapsed="false"
                      OnRunCell="Context.OnRunCell"
                      OnCancelCell="Context.OnCancelCell"
                      OnDeleteCell="Context.OnDeleteCell"
                      OnSelect="Context.OnSelectCell"
                      OnMoveUp="Context.OnMoveUp"
                      OnMoveDown="Context.OnMoveDown"
                      OnSourceChanged="Context.OnSourceChanged"
                      OnCellAction="Context.OnCellAction"
                      OnCellTypeChanged="Context.OnCellTypeChanged"
                      OnCellLanguageChanged="Context.OnCellLanguageChanged" />
            </div>
        }
    }
</div>

@foreach (var asset in _stylesheetAssets)
{
    <link @key="@($"css|{_extensionId}|{_layoutId}|{asset.AssetId}")"
          rel="stylesheet"
          href="@asset.Url"
          data-verso-extension-id="@_extensionId"
          data-verso-layout-id="@_layoutId"
          data-verso-asset-id="@asset.AssetId" />
}

@foreach (var asset in _scriptsBefore)
{
    <script @key="@($"js|{_extensionId}|{_layoutId}|{asset.AssetId}")"
            src="@asset.Url"
            type="@ScriptTypeAttr(asset)"
            defer="@DeferAttr(asset)"
            async="@AsyncAttr(asset)"
            data-verso-extension-id="@_extensionId"
            data-verso-layout-id="@_layoutId"
            data-verso-frame-instance-id="@_frameInstanceId"
            data-verso-asset-id="@asset.AssetId"></script>
}

<div class="verso-layout-root"
     data-extension-id="@_extensionId"
     data-layout-id="@_layoutId"
     data-frame-instance-id="@_frameInstanceId"
     @ref="_rootRef">
    @if (_html is not null)
    {
        @((MarkupString)_html)
    }
</div>

@foreach (var asset in _scriptsAfter)
{
    <script @key="@($"js|{_extensionId}|{_layoutId}|{asset.AssetId}")"
            src="@asset.Url"
            type="@ScriptTypeAttr(asset)"
            defer="@DeferAttr(asset)"
            async="@AsyncAttr(asset)"
            data-verso-extension-id="@_extensionId"
            data-verso-layout-id="@_layoutId"
            data-verso-frame-instance-id="@_frameInstanceId"
            data-verso-asset-id="@asset.AssetId"></script>
}

@code {
    [Parameter, EditorRequired] public INotebookService Service { get; set; } = default!;

    [CascadingParameter] public NotebookCellContext? Context { get; set; }

    private ElementReference _rootRef;
    private ElementReference _poolRef;
    private string? _html;
    private string _extensionId = "";
    private string _layoutId = "";
    private string _frameInstanceId = "";
    private bool _subscribed;
    private bool _remountNeeded;
    private bool _mounted;
    private bool _disposed;
    private IReadOnlyList<LayoutStaticAssetDescriptor> _stylesheetAssets
        = Array.Empty<LayoutStaticAssetDescriptor>();
    private IReadOnlyList<LayoutStaticAssetDescriptor> _scriptsBefore
        = Array.Empty<LayoutStaticAssetDescriptor>();
    private IReadOnlyList<LayoutStaticAssetDescriptor> _scriptsAfter
        = Array.Empty<LayoutStaticAssetDescriptor>();
    // Previous identity captured before re-fetching assets on layout switch, so we can
    // release the prior layout's blob URLs (WASM host) or simply drop our DOM links
    // (Server host) without leaking the previous layout's stylesheet into the new one.
    private string _previousExtensionId = "";
    private string _previousLayoutId = "";

    private static int s_globalSeq;

    protected override async Task OnInitializedAsync()
    {
        Service.OnLayoutChanged += HandleLayoutChanged;
        Service.OnLayoutUpdated += HandleLayoutUpdated;
        _subscribed = true;
        CaptureIdentity();
        _html = await Service.RenderActiveLayoutAsync() ?? string.Empty;
        await RefreshLayoutAssetsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;

        // Mount only after _html is populated. OnInitializedAsync awaits the host's
        // layout/render call, so Blazor renders this component once with _html=null
        // before the slot HTML is in the DOM; mounting against that render finds
        // no [data-cell-slot] elements and silently leaves cells in the hidden pool.
        if (_remountNeeded)
        {
            _remountNeeded = false;
            await UnmountSlotsAsync();
            _mounted = false;
        }

        if (!_mounted && !string.IsNullOrEmpty(_html))
        {
            _mounted = true;
            await MountSlotsAsync();
        }
    }

    private async Task MountSlotsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("versoCustomLayout.mountSlots", _rootRef, _poolRef);
            // Fire a generic post-mount hook so layout-specific JS (e.g. dashboard drag/
            // resize handlers) can attach to the freshly-mounted root without owning a
            // direct reference to it. Hook is a no-op if no handler is registered.
            await JS.InvokeVoidAsync("versoCustomLayout.notifyMounted", _rootRef, _extensionId, _layoutId);
        }
        catch (JSDisconnectedException) { }
        catch (Microsoft.JSInterop.JSException) { }
    }

    private async Task UnmountSlotsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("versoCustomLayout.unmountSlots", _rootRef, _poolRef);
        }
        catch (JSDisconnectedException) { }
        catch (Microsoft.JSInterop.JSException) { }
    }

    private void CaptureIdentity()
    {
        var active = Service.ActiveLayout;
        _previousExtensionId = _extensionId;
        _previousLayoutId = _layoutId;
        _extensionId = active?.ExtensionId ?? string.Empty;
        _layoutId = active?.LayoutId ?? string.Empty;

        var notebookSegment = Service.FilePath ?? "unsaved";
        var seq = System.Threading.Interlocked.Increment(ref s_globalSeq);
        _frameInstanceId = $"{notebookSegment}/{_layoutId}/{seq}";
    }

    private async Task RefreshLayoutAssetsAsync()
    {
        // Release any links held for a previous layout before fetching the new set, so
        // a stale stylesheet doesn't linger if the new layout has no assets at all.
        if (!string.IsNullOrEmpty(_previousExtensionId)
            && !string.IsNullOrEmpty(_previousLayoutId)
            && (!string.Equals(_previousExtensionId, _extensionId, StringComparison.Ordinal)
                || !string.Equals(_previousLayoutId, _layoutId, StringComparison.Ordinal)))
        {
            await Service.ReleaseLayoutStaticAssetsAsync(_previousExtensionId, _previousLayoutId);
        }

        if (string.IsNullOrEmpty(_extensionId) || string.IsNullOrEmpty(_layoutId))
        {
            _stylesheetAssets = Array.Empty<LayoutStaticAssetDescriptor>();
            _scriptsBefore = Array.Empty<LayoutStaticAssetDescriptor>();
            _scriptsAfter = Array.Empty<LayoutStaticAssetDescriptor>();
            return;
        }

        var assets = await Service.GetLayoutStaticAssetsAsync(_extensionId, _layoutId);
        var styles = new List<LayoutStaticAssetDescriptor>();
        var before = new List<LayoutStaticAssetDescriptor>();
        var after = new List<LayoutStaticAssetDescriptor>();
        foreach (var asset in assets)
        {
            if (IsScriptContentType(asset.ContentType))
            {
                if (asset.LoadHints?.Placement == LayoutScriptPlacement.BeforeLayoutHtml)
                    before.Add(asset);
                else
                    after.Add(asset);
            }
            else
            {
                styles.Add(asset);
            }
        }
        _stylesheetAssets = styles;
        _scriptsBefore = before;
        _scriptsAfter = after;
    }

    private static bool IsScriptContentType(string contentType) =>
        string.Equals(contentType, "text/javascript", StringComparison.Ordinal)
        || string.Equals(contentType, "application/javascript", StringComparison.Ordinal);

    private static string? ScriptTypeAttr(LayoutStaticAssetDescriptor asset) =>
        asset.LoadHints?.ModuleKind == LayoutScriptModuleKind.Module ? "module" : null;

    private static bool? DeferAttr(LayoutStaticAssetDescriptor asset)
    {
        // Default load mode is Defer. async/blocking explicitly omit the defer attribute.
        var mode = asset.LoadHints?.LoadMode ?? LayoutScriptLoadMode.Defer;
        return mode == LayoutScriptLoadMode.Defer ? true : null;
    }

    private static bool? AsyncAttr(LayoutStaticAssetDescriptor asset) =>
        asset.LoadHints?.LoadMode == LayoutScriptLoadMode.Async ? true : (bool?)null;

    private void HandleLayoutChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            CaptureIdentity();
            _html = await Service.RenderActiveLayoutAsync() ?? string.Empty;
            await RefreshLayoutAssetsAsync();
            // OnAfterRender handles unmount+mount via _remountNeeded so the JS
            // interop awaits don't interleave with the dispatcher work that the
            // re-render triggered by StateHasChanged depends on.
            _remountNeeded = true;
            StateHasChanged();
        });
    }

    private void HandleLayoutUpdated(LayoutUpdatedEventArgs args)
    {
        if (_disposed) return;
        if (!string.Equals(args.ExtensionId, _extensionId, StringComparison.OrdinalIgnoreCase) ||
            !string.Equals(args.LayoutId, _layoutId, StringComparison.OrdinalIgnoreCase))
            return;

        // When the host scopes the update to a specific renderer instance, ignore notifications
        // for other instances. An empty FrameInstanceId is treated as a broadcast.
        if (!string.IsNullOrEmpty(args.FrameInstanceId) &&
            !string.Equals(args.FrameInstanceId, _frameInstanceId, StringComparison.Ordinal))
            return;

        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;

            switch (args.Scope)
            {
                case "full":
                    _html = await Service.RenderActiveLayoutAsync() ?? string.Empty;
                    // OnAfterRender handles the cell teardown+remount via _remountNeeded.
                    _remountNeeded = true;
                    StateHasChanged();
                    break;

                case "cell":
                    if (args.CellId is { } cellId)
                        await RefreshCellSlotAsync(cellId);
                    break;

                case "metadata":
                    // No client-visible action in v1.0. The LayoutInteractionContext API
                    // does not currently emit this scope; layouts that depend on metadata
                    // changes should call RequestRender for a full re-render.
                    break;
            }
        });
    }

    private async Task RefreshCellSlotAsync(Guid cellId)
    {
        try
        {
            var info = await Service.GetCellContainerAsync(cellId);
            await JS.InvokeVoidAsync(
                "versoCustomLayout.updateSlotPosition",
                _rootRef,
                cellId.ToString(),
                info.Y, info.X, info.Width, info.Height);
        }
        catch (JSDisconnectedException) { }
        catch (Microsoft.JSInterop.JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        if (_subscribed)
        {
            Service.OnLayoutChanged -= HandleLayoutChanged;
            Service.OnLayoutUpdated -= HandleLayoutUpdated;
            _subscribed = false;
        }

        // Move any cells that were portaled into layout slots back to the page-level pool
        // before Blazor strips this component's subtree. Without this, the cell DOM nodes
        // ride along into the removed subtree and are orphaned from their owning <Cell>
        // components.
        await UnmountSlotsAsync();
    }
}
