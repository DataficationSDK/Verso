<div class="verso-sidebar-panel">
    @if (Service.IsLoaded && Service.IsMarketplaceSupported)
    {
        <div class="verso-marketplace">
            <div class="verso-marketplace-search">
                <div class="verso-marketplace-search-row">
                    <input class="verso-marketplace-input"
                           type="text"
                           placeholder="@UI.Marketplace_SearchPlaceholder"
                           value="@_searchQuery"
                           @oninput="HandleSearchInput" />
                    @if (Service.LocalExtensionPickMode == LocalExtensionPickMode.Upload)
                    {
                        <label class="verso-marketplace-more @(_isBusy ? "verso-marketplace-more--disabled" : "")"
                               aria-label="@UI.Marketplace_InstallFromFile"
                               data-verso-tip="@UI.Marketplace_InstallFromFile"
                               data-verso-tip-desc="@UI.Marketplace_InstallFromFileDesc">
                            &#8943;
                            <InputFile class="verso-marketplace-file"
                                       OnChange="HandleLocalFileSelectedAsync"
                                       accept=".dll,.nupkg" />
                        </label>
                    }
                    else if (Service.LocalExtensionPickMode == LocalExtensionPickMode.NativeBrowse)
                    {
                        <button class="verso-marketplace-more"
                                type="button"
                                disabled="@_isBusy"
                                aria-label="@UI.Marketplace_InstallFromFile"
                                data-verso-tip="@UI.Marketplace_InstallFromFile"
                                data-verso-tip-desc="@UI.Marketplace_InstallFromFileDesc"
                                @onclick="BrowseLocalAsync">&#8943;</button>
                    }
                </div>
                @if (_isSearching)
                {
                    <span class="verso-marketplace-status">@UI.Marketplace_Searching</span>
                }
            </div>

            @* The two facts the pane states before any row: how far an install reaches, and
               where the results came from. Each has one value today, so both read as a
               statement rather than a control. *@
            <div class="verso-marketplace-context">
                <span class="verso-marketplace-context-chip"
                      data-verso-tip="@UI.Marketplace_InstallScope"
                      data-verso-tip-desc="@UI.Marketplace_InstallScopeDesc">
                    @Emphasize(UI.Marketplace_InstallsInto, UI.Marketplace_ThisNotebook)
                </span>
                @if (SourceLabel is { Length: > 0 })
                {
                    <span class="verso-marketplace-context-chip"
                          data-verso-tip="@UI.Marketplace_PackageSources"
                          data-verso-tip-desc="@string.Join(", ", Service.MarketplaceSources)">
                        @Emphasize(UI.Marketplace_ResultsFrom, SourceLabel)
                    </span>
                }
            </div>

            @if (_installError is not null)
            {
                <div class="verso-marketplace-error">@_installError</div>
            }

            @if (_removedThisSession.Count > 0)
            {
                @* There is no single-extension unload, so removal is only recorded now and
                   takes effect on the next open. Saying so beats implying it is gone. *@
                <div class="verso-marketplace-notice">
                    @UI.Marketplace_RemovedNotice
                </div>
            }

            @{
                var rows = BuildRows();
            }
            @if (rows.Count == 0)
            {
                <div class="verso-marketplace-empty">
                    @(string.IsNullOrWhiteSpace(_searchQuery)
                        ? UI.Marketplace_NoneInstalled
                        : UI.Marketplace_NoResults)
                </div>
            }
            else
            {
                <div class="verso-marketplace-list">
                    @foreach (var row in rows)
                    {
                        var r = row;
                        <div class="verso-marketplace-row @StateClass(r)">
                            @* The lettered tile is always drawn and a package's own icon paints on
                               top, so a package with no icon, one whose art fails to decode, and one
                               whose icon host is unreachable all degrade to the letter with no error
                               handling. An installed package uses the copy on disk; anything else
                               uses the icon the feed reported. *@
                            <div class="verso-marketplace-tile" style="background: @Tint(r.Id)" aria-hidden="true">
                                @Initial(r.Id)
                                @if (r.IconSrc is not null)
                                {
                                    <img class="verso-marketplace-tile-icon" src="@r.IconSrc"
                                         loading="lazy" decoding="async" alt="" />
                                }
                            </div>
                            <div class="verso-marketplace-row-body">
                                <div class="verso-marketplace-row-head">
                                    <span class="verso-marketplace-row-id" data-verso-tip="@r.Id">@r.Id</span>
                                    @if (r.IsInstalled && r.Version is not null)
                                    {
                                        <span class="verso-marketplace-row-version">@r.Version</span>
                                    }
                                </div>

                                @if (r.Authors is not null || r.IsLocal)
                                {
                                    <div class="verso-marketplace-row-publisher">
                                        @if (r.Authors is not null)
                                        {
                                            <span>@r.Authors</span>
                                        }
                                        @if (r.IsLocal)
                                        {
                                            @if (r.Authors is not null)
                                            {
                                                <span class="verso-marketplace-row-dot">&#183;</span>
                                            }
                                            <span data-verso-tip="@UI.Marketplace_Local"
                                                  data-verso-tip-desc="@UI.Marketplace_LocalDesc">@UI.Marketplace_LocalFile</span>
                                        }
                                    </div>
                                }

                                @if (r.Description is not null)
                                {
                                    <div class="verso-marketplace-row-desc">@r.Description</div>
                                }

                                @* Only an installed package can say what it adds. A feed cannot
                                   report contributions, so an available package says nothing
                                   rather than guessing. *@
                                @if (r.Capabilities is { Count: > 0 })
                                {
                                    <div class="verso-marketplace-row-adds">
                                        @foreach (var cap in r.Capabilities)
                                        {
                                            <span class="verso-panel-chip verso-marketplace-add">
                                                @CapabilityLabel(cap)
                                            </span>
                                        }
                                    </div>
                                }
                                else if (r.Capabilities is { Count: 0 })
                                {
                                    <div class="verso-marketplace-row-adds">
                                        <span class="verso-panel-chip verso-panel-chip--warning"
                                              data-verso-tip="@UI.Marketplace_AddsNothing"
                                              data-verso-tip-desc="@UI.Marketplace_AddsNothingDesc">
                                            @UI.Marketplace_AddsNothing
                                        </span>
                                    </div>
                                }

                                <div class="verso-marketplace-row-foot">
                                    @if (FormatDownloads(r.DownloadCount) is { } downloads)
                                    {
                                        <span class="verso-marketplace-row-meta">@string.Format(UI.Marketplace_Downloads, downloads)</span>
                                    }
                                    <div class="verso-marketplace-row-state">
                                        @if (r.UnavailableReason is not null)
                                        {
                                            <span class="verso-panel-chip verso-panel-chip--error">@UI.Marketplace_NotLoaded</span>
                                            <button class="verso-marketplace-btn"
                                                    disabled="@_isBusy"
                                                    @onclick="() => UninstallAsync(r.Id)">@UI.Marketplace_Remove</button>
                                        }
                                        else if (r.IsInstalled)
                                        {
                                            <span class="verso-panel-chip verso-panel-chip--success">@UI.Marketplace_Installed</span>
                                            <button class="verso-marketplace-btn"
                                                    disabled="@_isBusy"
                                                    @onclick="() => UninstallAsync(r.Id)">@UI.Marketplace_Remove</button>
                                        }
                                        else
                                        {
                                            @if (r.Version is not null)
                                            {
                                                var selected = SelectedVersion(r.Id, r.Version);
                                                <div class="verso-marketplace-version-dropdown" @onfocusout="OnVersionDropdownFocusOut" tabindex="-1">
                                                    <button class="verso-marketplace-version-badge"
                                                            disabled="@_isBusy"
                                                            data-verso-tip="@UI.Marketplace_ChooseVersion"
                                                            @onclick="() => ToggleVersionDropdown(r.Id, r.Version)">
                                                        @selected
                                                        <span class="verso-marketplace-version-chevron">&#9662;</span>
                                                    </button>
                                                    @if (_openVersionDropdownId == r.Id)
                                                    {
                                                        <div class="verso-marketplace-version-popup">
                                                            @if (_loadingVersionsId == r.Id)
                                                            {
                                                                <div class="verso-marketplace-version-status">@UI.Common_Loading</div>
                                                            }
                                                            else if (_versionCache.TryGetValue(r.Id, out var versions))
                                                            {
                                                                @foreach (var ver in versions)
                                                                {
                                                                    var v = ver;
                                                                    var isActive = string.Equals(v, selected, StringComparison.OrdinalIgnoreCase);
                                                                    <button class="verso-marketplace-version-option @(isActive ? "verso-marketplace-version-option--active" : "")"
                                                                            @onclick="() => SelectVersion(r.Id, v)">@v</button>
                                                                }
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            <button class="verso-marketplace-btn verso-marketplace-btn--install"
                                                    disabled="@_isBusy"
                                                    @onclick="() => InstallAsync(r.Id, SelectedVersion(r.Id, r.Version))">@UI.Marketplace_Install</button>
                                        }
                                    </div>
                                </div>

                                @if (r.UnavailableReason is not null)
                                {
                                    <div class="verso-marketplace-row-note">@r.UnavailableReason</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (Service.IsLoaded)
    {
        var infos = Service.Extensions;
        var grouped = GroupByCategory(infos);
        @if (grouped.Count > 0)
        {
            <div class="verso-extension-loaded">
                <div class="verso-panel-section-title">@UI.Extensions_Loaded</div>
                @foreach (var group in grouped)
                {
                    var category = group.Key;
                    var isOpen = _expandedCategories.Contains(category);
                    <div class="verso-extension-group">
                        <button class="verso-extension-group-header" @onclick="() => ToggleCategory(category)">
                            <span class="verso-extension-group-chevron @(isOpen ? "verso-extension-group-chevron--open" : "")">@Chevron</span>
                            <span class="verso-extension-group-label">@CapabilityLabelPlural(category)</span>
                            <span class="verso-extension-group-count">@group.Value.Count</span>
                        </button>
                        @if (isOpen)
                        {
                            @foreach (var ext in group.Value)
                            {
                                var e = ext;
                                <div class="verso-extension-item">
                                    <div class="verso-extension-header">
                                        <div class="verso-extension-name">@e.Name</div>
                                        <div class="verso-extension-version">@e.Version</div>
                                        <button class="verso-extension-toggle @(e.Status == ExtensionStatus.Enabled ? "verso-extension-toggle--enabled" : "")"
                                                aria-label="@(e.Status == ExtensionStatus.Enabled ? UI.Extensions_Disable : UI.Extensions_Enable)"
                                                data-verso-tip="@(e.Status == ExtensionStatus.Enabled ? UI.Extensions_Disable : UI.Extensions_Enable)"
                                                @onclick="() => ToggleExtensionAsync(e.ExtensionId, e.Status)">
                                            @(e.Status == ExtensionStatus.Enabled ? UI.Extensions_On : UI.Extensions_Off)
                                        </button>
                                    </div>
                                    @if (e.Author is not null)
                                    {
                                        <div class="verso-extension-author">@e.Author</div>
                                    }
                                    @if (e.Description is not null)
                                    {
                                        <div class="verso-extension-description">@e.Description</div>
                                    }
                                    @if (e.Capabilities.Count > 1)
                                    {
                                        <div class="verso-extension-caps">
                                            @foreach (var cap in e.Capabilities)
                                            {
                                                <span class="verso-panel-chip verso-marketplace-add">@CapabilityLabel(cap)</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@using System.Globalization
@using System.Net
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable

@code {
    [Parameter] public INotebookService Service { get; set; } = default!;

    private readonly HashSet<string> _expandedCategories = new();
    private INotebookService? _subscribedService;

    // Marketplace search state
    private string _searchQuery = string.Empty;
    private IReadOnlyList<PackageSearchResultDto>? _searchResults;
    private bool _isSearching;
    private bool _isBusy;
    private string? _installError;
    private CancellationTokenSource? _searchCts;

    // Packages removed during this session. Uninstall records the removal but cannot unload
    // what is already running, so the pane says so for as long as that is true.
    private readonly HashSet<string> _removedThisSession = new(StringComparer.OrdinalIgnoreCase);

    // Per-package version selection, keyed by package id. A package absent from _selectedVersions
    // installs at the latest (the version the search returned). _versionCache holds the lazily
    // fetched version list for each package whose dropdown has been opened.
    private readonly Dictionary<string, string> _selectedVersions = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, IReadOnlyList<string>> _versionCache = new(StringComparer.OrdinalIgnoreCase);
    private string? _openVersionDropdownId;
    private string? _loadingVersionsId;

    private static readonly MarkupString Chevron = new(
        "<svg viewBox=\"0 0 16 16\" width=\"11\" height=\"11\" fill=\"none\" stroke=\"currentColor\" "
        + "stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 3.5 10.5 8 6 12.5\"/></svg>");

    private static readonly List<string> CategoryOrder = new()
    {
        "LanguageKernel", "Theme", "LayoutEngine", "CellType",
        "CellRenderer", "DataFormatter", "NotebookSerializer",
        "ToolbarAction", "MagicCommand", "NotebookPanel",
    };

    /// <summary>
    /// What an extension adds, named for a chip on a package. A capability with no name here
    /// falls back to its raw identifier, which reads as one run-together word, so keep this
    /// complete as capabilities are added.
    /// </summary>
    /// <remarks>
    /// A switch rather than a lookup table, because a table built once would hold whichever
    /// language happened to be current when the panel was first drawn.
    /// </remarks>
    private static string CapabilityLabel(string capability) => capability switch
    {
        "LanguageKernel" => UI.Capability_LanguageKernel,
        "CellRenderer" => UI.Capability_CellRenderer,
        "DataFormatter" => UI.Capability_DataFormatter,
        "CellType" => UI.Capability_CellType,
        "NotebookSerializer" => UI.Capability_NotebookSerializer,
        "Theme" => UI.Capability_Theme,
        "LayoutEngine" => UI.Capability_LayoutEngine,
        "ToolbarAction" => UI.Capability_ToolbarAction,
        "MagicCommand" => UI.Capability_MagicCommand,
        "NotebookPanel" => UI.Capability_NotebookPanel,
        "NotebookPostProcessor" => UI.Capability_NotebookPostProcessor,
        "CellPropertyProvider" => UI.Capability_CellPropertyProvider,
        "ExtensionSettings" => UI.Capability_ExtensionSettings,
        "CellInteractionHandler" => UI.Capability_CellInteractionHandler,
        "LayoutInteractionHandler" => UI.Capability_LayoutInteractionHandler,
        "LayoutLifecycleHandler" => UI.Capability_LayoutLifecycleHandler,
        "PanelInteractionHandler" => UI.Capability_PanelInteractionHandler,
        "Other" => UI.Capability_Other,
        _ => capability,
    };

    /// <summary>
    /// The same names in the plural, for a group header covering several extensions. Written
    /// out rather than derived, because a plural is not a singular with a letter on the end in
    /// most of the languages Verso ships in.
    /// </summary>
    private static string CapabilityLabelPlural(string capability) => capability switch
    {
        "LanguageKernel" => UI.Capability_LanguageKernel_Plural,
        "CellRenderer" => UI.Capability_CellRenderer_Plural,
        "DataFormatter" => UI.Capability_DataFormatter_Plural,
        "CellType" => UI.Capability_CellType_Plural,
        "NotebookSerializer" => UI.Capability_NotebookSerializer_Plural,
        "Theme" => UI.Capability_Theme_Plural,
        "LayoutEngine" => UI.Capability_LayoutEngine_Plural,
        "ToolbarAction" => UI.Capability_ToolbarAction_Plural,
        "MagicCommand" => UI.Capability_MagicCommand_Plural,
        "NotebookPanel" => UI.Capability_NotebookPanel_Plural,
        "NotebookPostProcessor" => UI.Capability_NotebookPostProcessor_Plural,
        "CellPropertyProvider" => UI.Capability_CellPropertyProvider_Plural,
        "ExtensionSettings" => UI.Capability_ExtensionSettings_Plural,
        "CellInteractionHandler" => UI.Capability_CellInteractionHandler_Plural,
        "LayoutInteractionHandler" => UI.Capability_LayoutInteractionHandler_Plural,
        "LayoutLifecycleHandler" => UI.Capability_LayoutLifecycleHandler_Plural,
        "PanelInteractionHandler" => UI.Capability_PanelInteractionHandler_Plural,
        "Other" => UI.Capability_Other_Plural,
        _ => capability,
    };

    /// <summary>
    /// Fills a sentence's single placeholder with emphasised text. The sentence is one resource
    /// rather than the two fragments either side of the emphasis, because which words fall on
    /// which side of it is a property of the language.
    /// </summary>
    private static MarkupString Emphasize(string sentence, string value)
        => new(string.Format(sentence, $"<b>{WebUtility.HtmlEncode(value)}</b>"));

    // Grouped by the raw capability rather than by its name, so which extensions land together
    // and in what order does not depend on the language the panel is being read in.
    private static List<KeyValuePair<string, List<ExtensionInfo>>> GroupByCategory(
        IReadOnlyList<ExtensionInfo> infos)
    {
        var groups = new Dictionary<string, List<ExtensionInfo>>();

        foreach (var ext in infos)
        {
            var primary = ext.Capabilities.Count > 0 ? ext.Capabilities[0] : "Other";

            if (!groups.TryGetValue(primary, out var list))
            {
                list = new List<ExtensionInfo>();
                groups[primary] = list;
            }
            list.Add(ext);
        }

        return groups
            .OrderBy(g =>
            {
                var idx = CategoryOrder.IndexOf(g.Key);
                return idx >= 0 ? idx : CategoryOrder.Count;
            })
            .ToList();
    }

    private void ToggleCategory(string category)
    {
        if (!_expandedCategories.Remove(category))
            _expandedCategories.Add(category);
    }

    protected override void OnParametersSet()
    {
        if (_subscribedService != Service)
        {
            if (_subscribedService is not null)
                _subscribedService.OnExtensionStatusChanged -= HandleExtensionStatusChanged;

            _subscribedService = Service;
            Service.OnExtensionStatusChanged += HandleExtensionStatusChanged;
        }
    }

    private async void HandleExtensionStatusChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleExtensionAsync(string extensionId, ExtensionStatus currentStatus)
    {
        if (currentStatus == ExtensionStatus.Enabled)
            await Service.DisableExtensionAsync(extensionId);
        else
            await Service.EnableExtensionAsync(extensionId);
    }

    // ── Rows ───────────────────────────────────────────────────────────

    /// <summary>
    /// One package in the pane's single list. Install state is a property of the row rather
    /// than the region it sits in, so a package is described the same way whatever state it
    /// is in.
    /// </summary>
    private sealed record MarketplaceRow(
        string Id,
        string? Version,
        string? Description,
        string? Authors,
        long? DownloadCount,
        bool IsInstalled,
        bool IsLocal,
        string? UnavailableReason,
        IReadOnlyList<string>? Capabilities,
        string? IconSrc);

    /// <summary>
    /// Merges what this notebook requires with what the current search returned. The installed
    /// entry is the only source for sideloaded files, for what failed to load, and for what a
    /// package contributed; a search result is the only source for description, author, and
    /// download count. A package in both takes each from whichever knows it.
    /// </summary>
    private List<MarketplaceRow> BuildRows()
    {
        var query = _searchQuery.Trim();
        var rows = new List<MarketplaceRow>();
        var listed = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var installed in Service.InstalledExtensions)
        {
            var match = _searchResults?.FirstOrDefault(
                p => string.Equals(p.Id, installed.Id, StringComparison.OrdinalIgnoreCase));

            var row = new MarketplaceRow(
                installed.Id,
                installed.Version ?? match?.Version,
                match?.Description,
                match?.Authors,
                match?.DownloadCount,
                IsInstalled: true,
                installed.IsLocal,
                installed.UnavailableReason,
                installed.Capabilities,
                // The copy on disk is preferred: it needs no network and is the only source for
                // a sideloaded package. The feed's URL is the fallback, which also covers a
                // package installed before icons were kept alongside it.
                installed.IconDataUri ?? match?.IconUrl);

            listed.Add(row.Id);
            if (Matches(row, query))
                rows.Add(row);
        }

        if (_searchResults is not null)
        {
            foreach (var package in _searchResults)
            {
                if (listed.Contains(package.Id))
                    continue;

                rows.Add(new MarketplaceRow(
                    package.Id,
                    package.Version,
                    package.Description,
                    package.Authors,
                    package.DownloadCount,
                    package.IsInstalled,
                    IsLocal: false,
                    UnavailableReason: null,
                    Capabilities: null,
                    IconSrc: package.IconUrl));
            }
        }

        // What is wrong first, then what is already here, then what could be added. OrderBy is
        // stable, so within each state the source order survives: declaration order for
        // installed packages, relevance for search results.
        return rows.OrderBy(StateRank).ToList();
    }

    private static int StateRank(MarketplaceRow row)
        => row.UnavailableReason is not null ? 0 : row.IsInstalled ? 1 : 2;

    private static string StateClass(MarketplaceRow row)
        => row.UnavailableReason is not null ? "verso-marketplace-row--error"
            : row.IsInstalled ? "verso-marketplace-row--installed"
            : string.Empty;

    // Installed rows are filtered here because they never went through the feed, so "type to
    // filter" means the same thing for every row in the list.
    private static bool Matches(MarketplaceRow row, string query)
        => query.Length == 0
            || row.Id.Contains(query, StringComparison.OrdinalIgnoreCase)
            || (row.Description?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false);

    /// <summary>Download counts, shortened so a five-digit number does not crowd a 300px rail.</summary>
    private static string? FormatDownloads(long? count)
    {
        if (count is not { } n || n < 0)
            return null;
        if (n >= 1_000_000_000)
            return Short(n / 1_000_000_000d) + "B";
        if (n >= 1_000_000)
            return Short(n / 1_000_000d) + "M";
        if (n >= 1_000)
            return Short(n / 1_000d) + "k";
        return n.ToString(CultureInfo.InvariantCulture);

        static string Short(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);
    }

    /// <summary>
    /// A colour for a package's tile, hashed from its id so it is the same on every render and
    /// in every session. Fixed saturation and lightness keep white text legible in any theme.
    /// </summary>
    private static string Tint(string id)
    {
        var hash = 0;
        foreach (var c in id)
            hash = (hash * 31 + c) % 360;
        return $"hsl({hash.ToString(CultureInfo.InvariantCulture)} 42% 38%)";
    }

    /// <summary>
    /// The letter on a package's tile. Extension ids are heavily prefixed (Company.Product.Thing),
    /// so the last segment is the part that distinguishes one package from its siblings; taking
    /// the first letter of the whole id would give a rail full of the same letter.
    /// </summary>
    private static string Initial(string id)
    {
        var lastDot = id.LastIndexOf('.');
        var name = lastDot >= 0 && lastDot < id.Length - 1 ? id[(lastDot + 1)..] : id;
        return name.Length > 0 ? char.ToUpperInvariant(name[0]).ToString() : "?";
    }

    /// <summary>Where results came from: the source itself when there is one, a count when more.</summary>
    private string SourceLabel => Service.MarketplaceSources.Count switch
    {
        0 => string.Empty,
        1 => Service.MarketplaceSources[0],
        var n => string.Format(UI.Marketplace_SourceCount, n)
    };

    // ── Marketplace ────────────────────────────────────────────────────

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        _installError = null;

        // Cancel any in-flight search; this input supersedes it.
        _searchCts?.Cancel();
        _searchCts?.Dispose();

        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchCts = null;
            _searchResults = null;
            _isSearching = false;
            return;
        }

        _searchCts = new CancellationTokenSource();
        var ct = _searchCts.Token;
        var query = _searchQuery;

        _isSearching = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            // Debounce so each keystroke doesn't fire a NuGet round-trip.
            await Task.Delay(300, ct);
            var results = await Service.SearchExtensionsAsync(query, 0, 20, includePrerelease: false, ct);
            if (ct.IsCancellationRequested) return;

            _searchResults = results;
            _isSearching = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer keystroke; the newer search owns the UI state.
        }
        catch (Exception ex)
        {
            _isSearching = false;
            _installError = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    // The version that will be installed for a package: the user's pick if they chose one,
    // otherwise the latest version the search returned.
    private string? SelectedVersion(string packageId, string? latest)
        => _selectedVersions.TryGetValue(packageId, out var v) ? v : latest;

    private async Task ToggleVersionDropdown(string packageId, string? latest)
    {
        if (_openVersionDropdownId == packageId)
        {
            _openVersionDropdownId = null;
            return;
        }

        _openVersionDropdownId = packageId;

        // Fetch the version list the first time this package's dropdown is opened.
        if (!_versionCache.ContainsKey(packageId))
            await LoadVersionsAsync(packageId, latest);
    }

    private async Task LoadVersionsAsync(string packageId, string? latest)
    {
        _loadingVersionsId = packageId;
        await InvokeAsync(StateHasChanged);

        try
        {
            var versions = await Service.GetExtensionVersionsAsync(packageId, includePrerelease: false, CancellationToken.None);

            // Fall back to the search's latest version when the feed can't enumerate versions
            // (e.g. a source without an all-versions endpoint), so the dropdown still offers the
            // default rather than showing an empty list.
            if (versions.Count == 0 && latest is not null)
                versions = new[] { latest };

            _versionCache[packageId] = versions;
        }
        catch
        {
            _versionCache[packageId] = latest is not null ? new[] { latest } : Array.Empty<string>();
        }
        finally
        {
            _loadingVersionsId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SelectVersion(string packageId, string version)
    {
        _selectedVersions[packageId] = version;
        _openVersionDropdownId = null;
    }

    private async Task OnVersionDropdownFocusOut()
    {
        // Delay so a click on a version option registers before the popup closes (the option's
        // onclick and this focusout race; the delay lets the selection win).
        await Task.Delay(150);
        _openVersionDropdownId = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task InstallAsync(string packageId, string? version)
    {
        _isBusy = true;
        _installError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await Service.InstallExtensionAsync(packageId, version, CancellationToken.None);
            if (!result.Success)
            {
                _installError = result.ErrorMessage ?? UI.Marketplace_InstallFailed;
            }
            else
            {
                _removedThisSession.Remove(packageId);
                await RefreshSearchResultsAsync();
            }
        }
        catch (Exception ex)
        {
            _installError = ex.Message;
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task UninstallAsync(string packageId)
    {
        _isBusy = true;
        _installError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Service.UninstallExtensionAsync(packageId);
            _removedThisSession.Add(packageId);
            await RefreshSearchResultsAsync();
        }
        catch (Exception ex)
        {
            _installError = ex.Message;
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Ceiling for a sideloaded package; comfortably above a typical extension .dll/.nupkg.
    private const long MaxLocalExtensionBytes = 64L * 1024 * 1024;

    private async Task HandleLocalFileSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;

        _isBusy = true;
        _installError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            await using var stream = file.OpenReadStream(MaxLocalExtensionBytes);
            var result = await Service.InstallLocalExtensionAsync(file.Name, stream, CancellationToken.None);
            if (!result.Success)
                _installError = result.ErrorMessage ?? UI.Marketplace_InstallFailed;
            else
                await RefreshSearchResultsAsync();
        }
        catch (Exception ex)
        {
            _installError = ex.Message;
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task BrowseLocalAsync()
    {
        _isBusy = true;
        _installError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await Service.BrowseAndInstallLocalExtensionAsync(CancellationToken.None);
            // A cancelled native dialog returns Success=false with no error; leave the UI quiet.
            if (!result.Success)
            {
                if (result.ErrorMessage is not null)
                    _installError = result.ErrorMessage;
            }
            else
            {
                await RefreshSearchResultsAsync();
            }
        }
        catch (Exception ex)
        {
            _installError = ex.Message;
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshSearchResultsAsync()
    {
        // Re-run the current query so each result's installed state reflects the change.
        if (string.IsNullOrWhiteSpace(_searchQuery))
            return;
        try
        {
            _searchResults = await Service.SearchExtensionsAsync(
                _searchQuery, 0, 20, includePrerelease: false, CancellationToken.None);
        }
        catch
        {
            // Keep the previous results if the refresh fails.
        }
    }

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        if (_subscribedService is not null)
            _subscribedService.OnExtensionStatusChanged -= HandleExtensionStatusChanged;
    }
}
