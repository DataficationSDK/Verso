<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Verso.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>verso</ToolCommandName>
    <RollForward>Major</RollForward>
    <PackageId>Verso.Cli</PackageId>
    <PackageDescription>Command-line tool for the Verso interactive notebook platform.</PackageDescription>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_IncludeVersoStaticAssets</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    blazor.web.js ships in the ASP.NET Core framework assets package rather than inside the
    shared framework, so the installed tool has no copy of its own. Asking for that package
    restores the copy that matches the SDK's ASP.NET Core version, and the target below puts it
    where the pack target and BlazorHostBuilder look for it.
  -->
  <PropertyGroup>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <Target Name="_CopyBlazorFrameworkJs" AfterTargets="Build">
    <Copy SourceFiles="$(BlazorFrameworkStaticWebAssetRoot)/blazor.web.js"
          DestinationFolder="$(OutputPath)wwwroot/_framework/"
          SkipUnchangedFiles="true"
          Condition="'$(BlazorFrameworkStaticWebAssetRoot)' != '' AND Exists('$(BlazorFrameworkStaticWebAssetRoot)/blazor.web.js')" />
    <Error Text="blazor.web.js was not found in the ASP.NET Core framework assets package, so verso serve would load without its Blazor script."
           Condition="!Exists('$(OutputPath)wwwroot/_framework/blazor.web.js')" />
  </Target>

  <!-- Bundle static web assets so the Blazor Server app works when installed
       as a global tool. BlazorHostBuilder detects invalid manifest paths at
       startup and falls back to Production mode, serving the bundled wwwroot
       via PhysicalFileProvider. -->
  <Target Name="_IncludeVersoStaticAssets">
    <ItemGroup>
      <!-- Static web assets manifest (used by dev-mode detection) -->
      <TfmSpecificPackageFile Include="$(OutputPath)Verso.Blazor.staticwebassets.runtime.json"
                              Condition="Exists('$(OutputPath)Verso.Blazor.staticwebassets.runtime.json')"
                              PackagePath="tools/$(TargetFramework)/any/" />
      <!-- Verso.Blazor wwwroot (served from /) -->
      <TfmSpecificPackageFile Include="..\Verso.Blazor\wwwroot\**\*"
                              PackagePath="tools/$(TargetFramework)/any/wwwroot/" />
      <!-- Verso.Blazor.Shared wwwroot (served from /_content/Verso.Blazor.Shared/) -->
      <TfmSpecificPackageFile Include="..\Verso.Blazor.Shared\wwwroot\**\*"
                              PackagePath="tools/$(TargetFramework)/any/wwwroot/_content/Verso.Blazor.Shared/" />
      <!-- Blazor framework JS (copied by _CopyBlazorFrameworkJs) -->
      <TfmSpecificPackageFile Include="$(OutputPath)wwwroot/_framework/blazor.web.js"
                              Condition="Exists('$(OutputPath)wwwroot/_framework/blazor.web.js')"
                              PackagePath="tools/$(TargetFramework)/any/wwwroot/_framework/blazor.web.js" />
    </ItemGroup>
  </Target>

  <!--
    Everything the CLI prints is reached through the generated Strings class, so a renamed or deleted
    key breaks the build instead of silently falling back to the key name. Each property reads its
    resource on access, which is what lets one process answer in the language it was asked for.
  -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Verso.Cli.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Verso.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Spectre.Console.Json" Version="0.49.1" />
    <PackageReference Include="PrettyPrompt" Version="4.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Verso\Verso.csproj" />
    <ProjectReference Include="..\Verso.Blazor\Verso.Blazor.csproj" />
    <ProjectReference Include="..\Verso.Blazor.Shared\Verso.Blazor.Shared.csproj" />
    <ProjectReference Include="..\Verso.FSharp\Verso.FSharp.csproj" />
    <ProjectReference Include="..\Verso.Python\Verso.Python.csproj" />
    <ProjectReference Include="..\Verso.JavaScript\Verso.JavaScript.csproj" />
    <ProjectReference Include="..\Verso.PowerShell\Verso.PowerShell.csproj" />
    <ProjectReference Include="..\Verso.Ado\Verso.Ado.csproj" />
    <ProjectReference Include="..\Verso.DataFrame\Verso.DataFrame.csproj" />
    <ProjectReference Include="..\Verso.Http\Verso.Http.csproj" />
  </ItemGroup>

</Project>
