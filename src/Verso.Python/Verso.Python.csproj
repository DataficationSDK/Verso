<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(VersoLibTargetFrameworks)</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Verso.Python</PackageId>
    <Title>Verso Python</Title>
    <Description>Python language kernel extension for Verso notebooks, running the interpreter installed on the machine.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Host/versohost.py" LogicalName="Verso.Python.Host.versohost.py" />
    <EmbeddedResource Include="Host/_versohost_display.py" LogicalName="Verso.Python.Host._versohost_display.py" />
    <EmbeddedResource Include="Host/_versohost_intel.py" LogicalName="Verso.Python.Host._versohost_intel.py" />
    <EmbeddedResource Include="Host/_versohost_scan.py" LogicalName="Verso.Python.Host._versohost_scan.py" />
    <EmbeddedResource Include="Host/_versohost_vars.py" LogicalName="Verso.Python.Host._versohost_vars.py" />
    <EmbeddedResource Include="Host/_versohost_wiretypes.py" LogicalName="Verso.Python.Host._versohost_wiretypes.py" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Verso.Python.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Verso.Abstractions\Verso.Abstractions.csproj" />
  </ItemGroup>

</Project>
