<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(VersoLibTargetFrameworks)</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Verso.Python</PackageId>
    <Title>Verso Python</Title>
    <Description>Python language kernel extension for Verso notebooks, running the interpreter installed on the machine.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Host/versohost.py" LogicalName="Verso.Python.Host.versohost.py" />
    <EmbeddedResource Include="Host/_versohost_bind.py" LogicalName="Verso.Python.Host._versohost_bind.py" />
    <EmbeddedResource Include="Host/_versohost_comm.py" LogicalName="Verso.Python.Host._versohost_comm.py" />
    <EmbeddedResource Include="Host/_versohost_display.py" LogicalName="Verso.Python.Host._versohost_display.py" />
    <EmbeddedResource Include="Host/_versohost_intel.py" LogicalName="Verso.Python.Host._versohost_intel.py" />
    <EmbeddedResource Include="Host/_versohost_scan.py" LogicalName="Verso.Python.Host._versohost_scan.py" />
    <EmbeddedResource Include="Host/_versohost_vars.py" LogicalName="Verso.Python.Host._versohost_vars.py" />
    <EmbeddedResource Include="Host/_versohost_wiretypes.py" LogicalName="Verso.Python.Host._versohost_wiretypes.py" />
  </ItemGroup>

  <!--
    Everything a Python cell writes for somebody to read is reached through the generated Strings
    class, so a renamed or deleted key breaks the build instead of silently falling back to the
    key name.
    Each property reads its resource on access, which is what lets one process answer in the
    language it was asked for.
  -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Verso.Python.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Verso.Python.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Verso.Abstractions\Verso.Abstractions.csproj" />
  </ItemGroup>

</Project>
