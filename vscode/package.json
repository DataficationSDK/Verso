{
  "name": "verso-notebook",
  "displayName": "Verso Notebook",
  "description": "%extension.description%",
  "version": "1.0.0",
  "publisher": "datafication",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0e3050",
    "theme": "dark"
  },
  "homepage": "https://www.versonotebooks.com",
  "bugs": {
    "url": "https://github.com/DataficationSDK/Verso/issues"
  },
  "qna": "https://github.com/DataficationSDK/Verso/discussions",
  "sponsor": {
    "url": "https://github.com/sponsors/TorreyBetts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DataficationSDK/Verso"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Data Science",
    "Machine Learning",
    "Visualization",
    "Notebooks",
    "Chat",
    "AI"
  ],
  "keywords": [
    "dotnet",
    ".net",
    "notebook",
    "notebooks",
    "interactive",
    "csharp",
    "c#",
    "fsharp",
    "f#",
    "python",
    "powershell",
    "sql",
    "javascript",
    "typescript",
    "jupyter",
    "ipynb",
    "polyglot-notebook",
    "dotnet-interactive",
    "repl",
    "data-science",
    "database",
    "ef-core",
    "entity-framework",
    "http-client",
    "rest-client",
    "dashboard",
    "visualization",
    "charts",
    "copilot",
    "ai"
  ],
  "activationEvents": [
    "onCustomEditor:verso.blazorNotebook",
    "onCustomEditor:verso.markdownNotebook",
    "onCommand:verso.newNotebook",
    "onCommand:verso.compareWithBaseline",
    "onCommand:verso.openInVerso"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "verso.newNotebook",
        "title": "%command.newNotebook.title%",
        "category": "Verso"
      },
      {
        "command": "verso.compareWithBaseline",
        "title": "%command.compareWithBaseline.title%",
        "category": "Verso",
        "icon": "$(diff)"
      },
      {
        "command": "verso.openInVerso",
        "title": "%command.openInVerso.title%",
        "category": "Verso"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "verso.compareWithBaseline",
          "when": "activeCustomEditorId == verso.blazorNotebook || activeCustomEditorId == verso.markdownNotebook"
        },
        {
          "command": "verso.openInVerso",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "verso.compareWithBaseline",
          "when": "activeCustomEditorId == verso.blazorNotebook || activeCustomEditorId == verso.markdownNotebook",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "verso.openInVerso",
          "when": "resourceExtname == .md && config.verso.showOpenInVersoMenu",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "verso.blazorNotebook",
        "displayName": "Verso Notebook",
        "selector": [
          {
            "filenamePattern": "*.verso"
          },
          {
            "filenamePattern": "*.ipynb"
          },
          {
            "filenamePattern": "*.dib"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "verso.markdownNotebook",
        "displayName": "Verso Notebook",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Verso Notebook",
      "properties": {
        "verso.hostPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.hostPath.description%"
        },
        "verso.dotnetPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.dotnetPath.description%"
        },
        "verso.python.interpreterPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.python.interpreterPath.description%"
        },
        "verso.python.autoInstall": {
          "type": "string",
          "enum": [
            "prompt",
            "auto",
            "off"
          ],
          "enumDescriptions": [
            "%configuration.python.autoInstall.prompt%",
            "%configuration.python.autoInstall.auto%",
            "%configuration.python.autoInstall.off%"
          ],
          "default": "prompt",
          "description": "%configuration.python.autoInstall.description%"
        },
        "verso.python.useUv": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.python.useUv.description%"
        },
        "verso.widgets.assetSource": {
          "type": "string",
          "enum": [
            "cdn",
            "bundled"
          ],
          "enumDescriptions": [
            "%configuration.widgets.assetSource.cdn%",
            "%configuration.widgets.assetSource.bundled%"
          ],
          "default": "cdn",
          "description": "%configuration.widgets.assetSource.description%"
        },
        "verso.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "de",
            "es",
            "ja",
            "zh-Hans"
          ],
          "enumItemLabels": [
            "%configuration.language.auto%",
            "English",
            "Deutsch",
            "Español",
            "日本語",
            "简体中文"
          ],
          "default": "auto",
          "description": "%configuration.language.description%"
        },
        "verso.extensionsPath": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%configuration.extensionsPath.description%"
        },
        "verso.preserveOriginalFormat": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.preserveOriginalFormat.description%"
        },
        "verso.showOpenInVersoMenu": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showOpenInVersoMenu.description%"
        }
      }
    },
    "chatParticipants": [
      {
        "id": "verso.copilot.notebook",
        "name": "verso",
        "fullName": "Verso Notebook",
        "description": "%chat.participant.description%",
        "isSticky": true,
        "commands": [
          {
            "name": "cells",
            "description": "%chat.cells.description%"
          },
          {
            "name": "run",
            "description": "%chat.run.description%"
          },
          {
            "name": "vars",
            "description": "%chat.vars.description%"
          },
          {
            "name": "props",
            "description": "%chat.props.description%"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "verso_listCells",
        "toolReferenceName": "verso_listCells",
        "tags": ["verso", "notebook", "cells"],
        "displayName": "%tool.listCells.displayName%",
        "userDescription": "%tool.listCells.userDescription%",
        "modelDescription": "List all cells in the active Verso notebook, showing each cell's source code, language, and outputs.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "verso_addCell",
        "toolReferenceName": "verso_addCell",
        "tags": ["verso", "notebook", "cells"],
        "displayName": "%tool.addCell.displayName%",
        "userDescription": "%tool.addCell.userDescription%",
        "modelDescription": "Add a new cell to the Verso notebook. The 'type' field determines the cell kind. For code cells, also set 'language' to the kernel. For non-code types (markdown, html, mermaid, etc.), only type is needed. Refer to the system prompt for available cell types and languages.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "description": "The kernel language for code cells. Not needed for non-code cell types. Refer to the system prompt for available languages."
            },
            "source": {
              "type": "string",
              "description": "The source code or content for the cell"
            },
            "type": {
              "type": "string",
              "description": "The cell type. Use 'code' for executable code cells (requires language). Other types vary by notebook. Refer to the system prompt for available types."
            },
            "position": {
              "type": "number",
              "description": "1-based position to insert the cell at. If omitted, the cell is added at the end."
            }
          },
          "required": ["type", "source"]
        }
      },
      {
        "name": "verso_updateCell",
        "toolReferenceName": "verso_updateCell",
        "tags": ["verso", "notebook", "cells"],
        "displayName": "%tool.updateCell.displayName%",
        "userDescription": "%tool.updateCell.userDescription%",
        "modelDescription": "Update the source code of an existing cell. Use the 1-based cell number (call verso_listCells first to find it).",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cellNumber": {
              "type": "number",
              "description": "1-based cell number to update"
            },
            "source": {
              "type": "string",
              "description": "The new source code for the cell"
            }
          },
          "required": ["cellNumber", "source"]
        }
      },
      {
        "name": "verso_removeCell",
        "toolReferenceName": "verso_removeCell",
        "tags": ["verso", "notebook", "cells"],
        "displayName": "%tool.removeCell.displayName%",
        "userDescription": "%tool.removeCell.userDescription%",
        "modelDescription": "Remove a cell from the notebook by its 1-based cell number.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cellNumber": {
              "type": "number",
              "description": "1-based cell number to remove"
            }
          },
          "required": ["cellNumber"]
        }
      },
      {
        "name": "verso_runCell",
        "toolReferenceName": "verso_runCell",
        "tags": ["verso", "notebook", "execution"],
        "displayName": "%tool.runCell.displayName%",
        "userDescription": "%tool.runCell.userDescription%",
        "modelDescription": "Execute a specific cell by its 1-based cell number and return the output.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cellNumber": {
              "type": "number",
              "description": "1-based cell number to execute"
            }
          },
          "required": ["cellNumber"]
        }
      },
      {
        "name": "verso_runAll",
        "toolReferenceName": "verso_runAll",
        "tags": ["verso", "notebook", "execution"],
        "displayName": "%tool.runAll.displayName%",
        "userDescription": "%tool.runAll.userDescription%",
        "modelDescription": "Execute all cells in the notebook sequentially and return results.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "verso_listVariables",
        "toolReferenceName": "verso_listVariables",
        "tags": ["verso", "notebook", "variables"],
        "displayName": "%tool.listVariables.displayName%",
        "userDescription": "%tool.listVariables.userDescription%",
        "modelDescription": "List all variables currently in scope in the notebook kernel, showing name, type, and value preview.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "verso_inspectVariable",
        "toolReferenceName": "verso_inspectVariable",
        "tags": ["verso", "notebook", "variables"],
        "displayName": "%tool.inspectVariable.displayName%",
        "userDescription": "%tool.inspectVariable.userDescription%",
        "modelDescription": "Get the detailed value of a specific variable by name.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "The variable name to inspect"
            }
          },
          "required": ["name"]
        }
      },
      {
        "name": "verso_getLanguages",
        "toolReferenceName": "verso_getLanguages",
        "tags": ["verso", "notebook"],
        "displayName": "%tool.getLanguages.displayName%",
        "userDescription": "%tool.getLanguages.userDescription%",
        "modelDescription": "List the available languages/kernels for the active notebook.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "verso_listParameters",
        "toolReferenceName": "verso_listParameters",
        "tags": ["verso", "notebook", "parameters"],
        "displayName": "%tool.listParameters.displayName%",
        "userDescription": "%tool.listParameters.userDescription%",
        "modelDescription": "List all parameters defined in the notebook. Parameters are named, typed values (string, int, float, bool, date, datetime) that can be set before execution to control notebook behavior.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "verso_addParameter",
        "toolReferenceName": "verso_addParameter",
        "tags": ["verso", "notebook", "parameters"],
        "displayName": "%tool.addParameter.displayName%",
        "userDescription": "%tool.addParameter.userDescription%",
        "modelDescription": "Add a new parameter to the notebook. Supported types: string, int, float, bool, date (yyyy-MM-dd), datetime (ISO 8601). A parameters cell is automatically created if one does not exist.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "The parameter name"
            },
            "type": {
              "type": "string",
              "description": "The parameter type: string, int, float, bool, date, or datetime",
              "enum": ["string", "int", "float", "bool", "date", "datetime"]
            },
            "description": {
              "type": "string",
              "description": "A human-readable description of the parameter"
            },
            "defaultValue": {
              "type": "string",
              "description": "The default value as a string (parsed according to the type)"
            },
            "required": {
              "type": "boolean",
              "description": "Whether the parameter is required"
            }
          },
          "required": ["name", "type"]
        }
      },
      {
        "name": "verso_updateParameter",
        "toolReferenceName": "verso_updateParameter",
        "tags": ["verso", "notebook", "parameters"],
        "displayName": "%tool.updateParameter.displayName%",
        "userDescription": "%tool.updateParameter.userDescription%",
        "modelDescription": "Update an existing parameter's properties. Only the fields you provide will be changed. Use verso_listParameters first to see current parameters.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "The name of the parameter to update"
            },
            "type": {
              "type": "string",
              "description": "New type: string, int, float, bool, date, or datetime",
              "enum": ["string", "int", "float", "bool", "date", "datetime"]
            },
            "description": {
              "type": "string",
              "description": "New description"
            },
            "defaultValue": {
              "type": "string",
              "description": "New default value as a string (parsed according to the type)"
            },
            "required": {
              "type": "boolean",
              "description": "Whether the parameter is required"
            }
          },
          "required": ["name"]
        }
      },
      {
        "name": "verso_removeParameter",
        "toolReferenceName": "verso_removeParameter",
        "tags": ["verso", "notebook", "parameters"],
        "displayName": "%tool.removeParameter.displayName%",
        "userDescription": "%tool.removeParameter.userDescription%",
        "modelDescription": "Remove a parameter from the notebook by name. This also removes the corresponding variable from the kernel.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "The name of the parameter to remove"
            }
          },
          "required": ["name"]
        }
      },
      {
        "name": "verso_getCellProperties",
        "toolReferenceName": "verso_getCellProperties",
        "tags": ["verso", "notebook", "properties"],
        "displayName": "%tool.getCellProperties.displayName%",
        "userDescription": "%tool.getCellProperties.userDescription%",
        "modelDescription": "Get the configurable properties for a specific cell. Properties are extension-provided settings like visibility, formatting, or tags. Call this before verso_updateCellProperty to discover available properties and their current values. The response includes providerExtensionId values needed for updates.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cellNumber": {
              "type": "number",
              "description": "1-based cell number to get properties for"
            }
          },
          "required": ["cellNumber"]
        }
      },
      {
        "name": "verso_updateCellProperty",
        "toolReferenceName": "verso_updateCellProperty",
        "tags": ["verso", "notebook", "properties"],
        "displayName": "%tool.updateCellProperty.displayName%",
        "userDescription": "%tool.updateCellProperty.userDescription%",
        "modelDescription": "Update a property on a cell. Call verso_getCellProperties first to discover the available properties, their field types, and the providerExtensionId needed for this call. For Select fields, use the option value (not display name). For Toggle fields, use 'true' or 'false'.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cellNumber": {
              "type": "number",
              "description": "1-based cell number to update"
            },
            "providerExtensionId": {
              "type": "string",
              "description": "The provider extension ID from verso_getCellProperties results"
            },
            "propertyName": {
              "type": "string",
              "description": "The property name (the 'name' field, not 'displayName')"
            },
            "value": {
              "type": "string",
              "description": "The new value as a string. For Toggle: 'true'/'false'. For Select: use the option value. For Tags: comma-separated values."
            }
          },
          "required": ["cellNumber", "providerExtensionId", "propertyName", "value"]
        }
      },
      {
        "name": "verso_listLayouts",
        "toolReferenceName": "verso_listLayouts",
        "tags": ["verso", "notebook", "layout"],
        "displayName": "%tool.listLayouts.displayName%",
        "userDescription": "%tool.listLayouts.userDescription%",
        "modelDescription": "List the layouts registered for this notebook (for example Notebook or Dashboard). Each entry includes its displayName, the extensionId and layoutId needed by verso_switchLayout, and whether it is currently active. Call this before verso_switchLayout to discover the qualified identity of the target layout.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "verso_switchLayout",
        "toolReferenceName": "verso_switchLayout",
        "tags": ["verso", "notebook", "layout"],
        "displayName": "%tool.switchLayout.displayName%",
        "userDescription": "%tool.switchLayout.userDescription%",
        "modelDescription": "Switch the notebook's active layout. Call verso_listLayouts first to get the extensionId and layoutId of the target layout. The choice is saved with the notebook. Some layouts (such as Dashboard) present cells differently, for example output-only with grid positions.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {
            "extensionId": {
              "type": "string",
              "description": "The owning extension id of the target layout, from verso_listLayouts"
            },
            "layoutId": {
              "type": "string",
              "description": "The layoutId of the target layout, from verso_listLayouts"
            }
          },
          "required": ["extensionId", "layoutId"]
        }
      },
      {
        "name": "verso_moveCell",
        "toolReferenceName": "verso_moveCell",
        "tags": ["verso", "notebook", "cells"],
        "displayName": "%tool.moveCell.displayName%",
        "userDescription": "%tool.moveCell.userDescription%",
        "modelDescription": "Move a cell to a different position in the notebook. Both numbers are 1-based. Call verso_listCells first to confirm the current order.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cellNumber": {
              "type": "number",
              "description": "1-based number of the cell to move"
            },
            "toPosition": {
              "type": "number",
              "description": "1-based position to move the cell to"
            }
          },
          "required": ["cellNumber", "toPosition"]
        }
      },
      {
        "name": "verso_changeCellType",
        "toolReferenceName": "verso_changeCellType",
        "tags": ["verso", "notebook", "cells"],
        "displayName": "%tool.changeCellType.displayName%",
        "userDescription": "%tool.changeCellType.userDescription%",
        "modelDescription": "Change a cell's type (for example code, markdown, html, mermaid). Call verso_getLanguages or verso_listCells to see available types. Changing the type clears the cell's outputs. For code cells the language is set automatically; use verso_changeCellLanguage to choose a different one.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cellNumber": {
              "type": "number",
              "description": "1-based number of the cell to change"
            },
            "type": {
              "type": "string",
              "description": "The new cell type id (for example 'code', 'markdown', 'html')"
            }
          },
          "required": ["cellNumber", "type"]
        }
      },
      {
        "name": "verso_changeCellLanguage",
        "toolReferenceName": "verso_changeCellLanguage",
        "tags": ["verso", "notebook", "cells"],
        "displayName": "%tool.changeCellLanguage.displayName%",
        "userDescription": "%tool.changeCellLanguage.userDescription%",
        "modelDescription": "Change the kernel language of a code cell (for example csharp, sql, python). Call verso_getLanguages to list valid languages. Changing the language clears the cell's outputs.",
        "canBeReferencedInPrompt": true,
        "when": "verso.notebookOpen",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cellNumber": {
              "type": "number",
              "description": "1-based number of the cell to change"
            },
            "language": {
              "type": "string",
              "description": "The new language id (for example 'csharp', 'sql', 'python')"
            }
          },
          "required": ["cellNumber", "language"]
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:host": "dotnet publish ../src/Verso.Host -c Release -o host",
    "build:wasm": "dotnet publish ../src/Verso.Blazor.Wasm -c Release -o blazor-wasm",
    "build:all": "npm run build:host && npm run build:wasm && npm run build",
    "watch": "node esbuild.mjs --watch",
    "lint": "tsc --noEmit",
    "pretest": "tsc -p ./tsconfig.test.json",
    "test": "node ./out-test/test/runTest.js",
    "package": "npm run build:all && vsce package --skip-license"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^25.2.3",
    "@types/vscode": "^1.99.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.21.0",
    "glob": "^10.3.10",
    "mocha": "^10.4.0",
    "typescript": "^5.4.0"
  }
}
