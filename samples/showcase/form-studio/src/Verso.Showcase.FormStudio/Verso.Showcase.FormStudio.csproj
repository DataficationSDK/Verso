<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(VersoLibTargetFrameworks)</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Verso.Showcase.FormStudio</PackageId>
    <Title>Verso Showcase: Form Studio</Title>
    <Description>Sample Verso layout extension: an isolated dashboard builder. Drag input widgets and charts onto a canvas, bind them to kernel variables, and the notebook becomes a live, parameterized app. A showcase of the Verso layout system.</Description>
    <PackageTags>verso;notebook;layout;sample;showcase;dashboard;charts</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\Verso.Abstractions\Verso.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="assets\vendor\chart.LICENSE.txt" Pack="true" PackagePath="third-party-licenses\" />
  </ItemGroup>

  <!--
    The renderer ships as a single self-contained module. The entry point is assembled at
    runtime (see RendererScript) by concatenating the vendored chart library and our own
    form.js. Each piece is embedded so the extension stays one deployable assembly.

    Vendored library (MIT, bundled verbatim, license kept beside it):
      - Chart.js 4.4.6  (assets/vendor/chart.umd.js) — the auto-registering UMD build.
  -->
  <ItemGroup>
    <EmbeddedResource Include="assets\form.js">
      <LogicalName>Verso.Showcase.FormStudio.form.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\vendor\chart.umd.js">
      <LogicalName>Verso.Showcase.FormStudio.vendor.chart.umd.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
