<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Verso.Layout.ImageEditor</PackageId>
    <Version>1.0.0</Version>
    <Authors>Datafication</Authors>
    <Description>Verso layout extension: an isolated image-compositor editor that presents the notebook as a layered image document.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\Verso.Abstractions\Verso.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\main.js">
      <LogicalName>Verso.Layout.ImageEditor.main.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
