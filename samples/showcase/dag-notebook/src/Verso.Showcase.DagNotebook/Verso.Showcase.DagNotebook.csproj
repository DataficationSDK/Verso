<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(VersoLibTargetFrameworks)</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Verso.Showcase.DagNotebook</PackageId>
    <Title>Verso Showcase: DAG Notebook</Title>
    <Description>Sample Verso layout extension: a notebook layout with dependency-aware reactive execution. Cells that share variables are linked with badges, and running a cell re-runs its dependents in dependency order. A showcase of the Verso layout system.</Description>
    <PackageTags>verso;notebook;layout;sample;showcase;dag;reactive</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\Verso.Abstractions\Verso.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
