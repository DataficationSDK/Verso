<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(VersoLibTargetFrameworks)</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Verso.Showcase.GridStudio</PackageId>
    <Title>Verso Showcase: Grid Studio</Title>
    <Description>Sample Verso layout extension: an isolated spreadsheet editor that binds a DataBlock kernel variable to an editable, Excel-like grid and writes edits back as a DataBlock. A showcase of the Verso layout system.</Description>
    <PackageTags>verso;notebook;layout;sample;showcase;spreadsheet;grid;datablock</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\Verso.Abstractions\Verso.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="assets\vendor\jspreadsheet-ce.LICENSE.txt" Pack="true" PackagePath="third-party-licenses\" />
    <None Include="assets\vendor\jsuites.LICENSE.txt" Pack="true" PackagePath="third-party-licenses\" />
  </ItemGroup>

  <!--
    The renderer ships as a single self-contained module. The entry point is assembled at
    runtime (see RendererScript) by concatenating the vendored grid library, its helper
    library, and our own grid.js. Each piece is embedded so the extension stays one file.

    Vendored libraries (both MIT, bundled verbatim, licenses kept beside them):
      - Jspreadsheet CE 4.15.0  (assets/vendor/jspreadsheet.js + .css)
      - jsuites 5.13.5          (assets/vendor/jsuites.js + .css)
  -->
  <ItemGroup>
    <EmbeddedResource Include="assets\grid.js">
      <LogicalName>Verso.Showcase.GridStudio.grid.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\vendor\jspreadsheet.js">
      <LogicalName>Verso.Showcase.GridStudio.vendor.jspreadsheet.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\vendor\jspreadsheet.css">
      <LogicalName>Verso.Showcase.GridStudio.vendor.jspreadsheet.css</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\vendor\jsuites.js">
      <LogicalName>Verso.Showcase.GridStudio.vendor.jsuites.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\vendor\jsuites.css">
      <LogicalName>Verso.Showcase.GridStudio.vendor.jsuites.css</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
