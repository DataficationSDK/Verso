<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Verso.Layout.GridStudio</PackageId>
    <Version>1.0.0</Version>
    <Authors>Datafication</Authors>
    <Description>Verso layout extension: an isolated spreadsheet editor that binds a DataBlock kernel variable to an editable, Excel-like grid and writes edits back as a DataBlock.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\Verso.Abstractions\Verso.Abstractions.csproj" />
  </ItemGroup>

  <!--
    The renderer ships as a single self-contained module. The entry point is assembled at
    runtime (see RendererScript) by concatenating the vendored grid library, its helper
    library, and our own grid.js. Each piece is embedded so the extension stays one file.

    Vendored libraries (both MIT, bundled verbatim, licenses kept beside them):
      - Jspreadsheet CE 4.15.0  (assets/vendor/jspreadsheet.js + .css)
      - jsuites 5.13.5          (assets/vendor/jsuites.js + .css)
  -->
  <ItemGroup>
    <EmbeddedResource Include="assets\grid.js">
      <LogicalName>Verso.Layout.GridStudio.grid.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\vendor\jspreadsheet.js">
      <LogicalName>Verso.Layout.GridStudio.vendor.jspreadsheet.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\vendor\jspreadsheet.css">
      <LogicalName>Verso.Layout.GridStudio.vendor.jspreadsheet.css</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\vendor\jsuites.js">
      <LogicalName>Verso.Layout.GridStudio.vendor.jsuites.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\vendor\jsuites.css">
      <LogicalName>Verso.Layout.GridStudio.vendor.jsuites.css</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
