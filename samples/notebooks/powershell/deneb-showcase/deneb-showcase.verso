    {
      "id": "ebec7a9d-b7ed-424d-8e49-8c9b122e0712",
      "type": "code",
      "language": "powershell",
      "source": "$startYear = 2001\n$endYear = (Get-Date).Year\n\n$bankFailureTemplate |\n    Set-FdicBankFailurePeriod -Failures $bankFailures -StartYear $startYear -EndYear $endYear |\n    Show-Vega -Renderer canvas",
      "outputs": [
        {
          "mimeType": "text/x-verso-widget",
          "content": "\u003C!doctype html\u003E\n\u003Chtml\u003E\n\u003Chead\u003E\n    \u003Cmeta charset=\u0022utf-8\u0022\u003E\n    \u003Cscript src=\u0022https://cdn.jsdelivr.net/npm/vega@6.3.1\u0022\u003E\u003C/script\u003E\n    \u003Cscript src=\u0022https://cdn.jsdelivr.net/npm/vega-lite@6.4.3\u0022\u003E\u003C/script\u003E\n    \u003Cscript src=\u0022https://cdn.jsdelivr.net/npm/vega-embed@7.1.0\u0022\u003E\u003C/script\u003E\n    \u003Cstyle\u003E\n        html, body {\n            margin: 0;\n            padding: 0;\n            background: var(--verso-cell-output-background, white);\n            color: var(--verso-cell-output-foreground, #1e1e1e);\n            font-family: var(--verso-ui-font-family, sans-serif);\n        }\n        #vis { width: 100%; overflow: auto; }\n        .error { padding: 12px; color: #c62828; white-space: pre-wrap; }\n    \u003C/style\u003E\n\u003C/head\u003E\n\u003Cbody\u003E\n    \u003Cdiv id=\u0022vis\u0022\u003E\u003C/div\u003E\n    \u003Cscript\u003E\n        const binary = atob(\\u002BcycpLCdHJywgJ0InKV06JycifSwieCI6eyJmaWVsZCI6IngifSwieSI6eyJmaWVsZCI6InkifSwidG9vbHRpcCI6eyJzaWduYWwiOiJ7J0JhbmsnOmRhdHVtLmRhdHVtLkJhbmsgLCAnRGF0ZSc6ZGF0dW0uZGF0dW0uZnJpZW5kbHlEYXRlICwnQXNzZXRzJzpyZXBsYWNlKCBmb3JtYXQoZGF0dW0uZGF0dW0uQXNzZXRzLCckLjN\\u0022);\n        const bytes = Uint8Array.from(binary, character =\u003E character.charCodeAt(0));\n        const spec = JSON.parse(new TextDecoder().decode(bytes));\n\n        vegaEmbed(\u0022#vis\u0022, spec, {\n            mode: \u0022vega\u0022,\n            renderer: \u0022canvas\u0022,\n            actions: true\n        }).catch(error =\u003E {\n            document.body.innerHTML = \u0027\u003Cdiv class=\u0022error\u0022\u003E\u003C/div\u003E\u0027;\n            document.querySelector(\u0022.error\u0022).textContent = error.stack || error.message;\n        });\n    \u003C/script\u003E\n\u003C/body\u003E\n\u003C/html\u003E"
        }
      ]
    },
    {
      "id": "9df885d4-bb57-4c79-af31-519cf18890a4",
      "type": "code",
      "language": "powershell",
      "source": "#!import ./knowledge-graphs.ps1\n\n# Who owns the brands? Wikidata P127, with source qualifiers and revisions.\n# Automotive examples: Audi, Porsche, Bentley, Lamborghini, Skoda, Mini, Rolls-Royce, Ducati.\n# Open-ended statements are NOT verified current ownership; isolated nodes mean missing eligible P127.\n$brandIds = @(\u0027Q23317\u0027, \u0027Q40993\u0027, \u0027Q27224\u0027, \u0027Q35886\u0027, \u0027Q29637\u0027, \u0027Q116232\u0027, \u0027Q234803\u0027, \u0027Q271812\u0027)\n$depth = 2\n$includeHistorical = $false # Set true to include dated historical statements.\n\n$ownershipTemplate = Get-DenebShowcaseSpec \u0027Force Directed Graph/Spec.json\u0027\n$brandOwnership = Get-WikidataOwnershipGraph -EntityId $brandIds -Depth $depth -IncludeHistorical $includeHistorical\n\n$ownershipTemplate |\n    Set-DenebRelationshipGraph -Graph $brandOwnership |\n    Show-Vega -Renderer canvas",
      "outputs": [
        {
          "mimeType": "text/plain",
          "content": "Imported knowledge-graphs.ps1"
        },
        {
          "mimeType": "text/x-verso-widget",
          "content": "\u003C!doctype html\u003E\n\u003Chtml\u003E\n\u003Chead\u003E\n    \u003Cmeta charset=\u0022utf-8\u0022\u003E\n    \u003Cscript src=\u0022https://cdn.jsdelivr.net/npm/vega@6.3.1\u0022\u003E\u003C/script\u003E\n    \u003Cscript src=\u0022https://cdn.jsdelivr.net/npm/vega-lite@6.4.3\u0022\u003E\u003C/script\u003E\n    \u003Cscript src=\u0022https://cdn.jsdelivr.net/npm/vega-embed@7.1.0\u0022\u003E\u003C/script\u003E\n    \u003Cstyle\u003E\n        html, body {\n            margin: 0;\n            padding: 0;\n            background: var(--verso-cell-output-background, white);\n            color: var(--verso-cell-output-foreground, #1e1e1e);\n            font-family: var(--verso-ui-font-family, sans-serif);\n        }\n        #vis { width: 100%; overflow: auto; }\n        .error { padding: 12px; color: #c62828; white-space: pre-wrap; }\n    \u003C/style\u003E\n\u003C/head\u003E\n\u003Cbody\u003E\n    \u003Cdiv id=\u0022vis\u0022\u003E\u003C/div\u003E\n    \u003Cscript\u003E\n        const binary = atob(\\u0022);\n        const bytes = Uint8Array.from(binary, character =\u003E character.charCodeAt(0));\n        const spec = JSON.parse(new TextDecoder().decode(bytes));\n\n        vegaEmbed(\u0022#vis\u0022, spec, {\n            mode: \u0022vega\u0022,\n            renderer: \u0022canvas\u0022,\n            actions: true\n        }).catch(error =\u003E {\n            document.body.innerHTML = \u0027\u003Cdiv class=\u0022error\u0022\u003E\u003C/div\u003E\u0027;\n            document.querySelector(\u0022.error\u0022).textContent = error.stack || error.message;\n        });\n    \u003C/script\u003E\n\u003C/body\u003E\n\u003C/html\u003E"
        }
      ]
    },
    {
      "id": "00bd3735-fcc0-455a-b13d-9c69d6b79391",
      "type": "code",
      "language": "powershell",
      "source": "#!import ./knowledge-graphs.ps1\n\n# Musical connections: shared members, not inferred collaborations or a current lineup.\n# Dates and instruments are preserved; one edge groups all periods for a person/band pair.\n$bandIds = @(\n    \u00275b11f4ce-a62d-471e-81fc-a69a8278c7da\u0027, # Nirvana\n    \u002767f66c07-6e61-4026-ade5-7e782fad3a5d\u0027, # Foo Fighters\n    \u00277dc8f5bd-9d0b-4087-9f73-dc164950bbd8\u0027, # Queens of the Stone Age\n    \u00274bc09c51-5d42-4c93-9ba6-8cc21a0edb8d\u0027, # Them Crooked Vultures\n    \u00271f36a3a2-9687-4819-ac55-54d7ff0b8b88\u0027, # \u0410\u0440\u0438\u044F\n    \u002776f95aaa-9be1-47a1-8db8-731cb77cf938\u0027  # \u041A\u0438\u043F\u0435\u043B\u043E\u0432 (group)\n)\n$sharedMembersOnly = $true # Set false to include everyone (a denser graph).\n$includeFormerMembers = $true # Dashed links: all returned membership periods ended.\n\n$musicTemplate = Get-DenebShowcaseSpec \u0027Force Directed Graph/Spec.json\u0027\n$musicConnections = Get-MusicBrainzBandGraph -BandId $bandIds -IncludeFormerMembers $includeFormerMembers -SharedMembersOnly $sharedMembersOnly\n\n$musicTemplate |\n    Set-DenebRelationshipGraph -Graph $musicConnections |\n    Show-Vega -Renderer canvas",
      "outputs": [
        {
          "mimeType": "text/plain",
          "content": "Imported knowledge-graphs.ps1"
        },
