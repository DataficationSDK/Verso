<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Verso.Templates</PackageId>
    <Title>Verso Templates</Title>
    <Description>Project templates for building Verso extensions.</Description>
    <TargetFramework>net8.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The template folder sits outside this project directory, so each file needs an
      explicit PackagePath: without it, NuGet packs out-of-tree content flat (losing
      .template.config/ and the MyExtension.Tests/ folder, and dropping one of the
      two GlobalUsings.cs files as a NU5118 collision).
    -->
    <Content Include="..\Verso.Extension.Template\**\*"
             Exclude="..\Verso.Extension.Template\**\bin\**;..\Verso.Extension.Template\**\obj\**"
             PackagePath="content\Verso.Extension.Template\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
